<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="OramaGo.Views.VendaCreatePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OramaGo.Models"
             xmlns:converters="clr-namespace:OramaGo.Converters"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" 
                     Command="{Binding SalvarVendaCommand}" 
                     IconImageSource="save.png"
                     IsEnabled="{Binding CanSave}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="0" Spacing="0">

            <!-- Informações da Venda -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20">
                <StackLayout Spacing="15">
                    <Label Text="📋 Informações da Venda" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#333" />

                    <!-- Número e Data -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <StackLayout Grid.Column="0">
                            <Label Text="Número" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding Venda.Numero}" 
                                   IsReadOnly="True"
                                   BackgroundColor="#F5F5F5" />
                        </StackLayout>
                        
                        <StackLayout Grid.Column="1">
                            <Label Text="Data da Venda" FontSize="12" TextColor="Gray" />
                            <DatePicker Date="{Binding Venda.DataVenda}" 
                                        BackgroundColor="White" />
                        </StackLayout>
                    </Grid>

                    <!-- Status -->
                    <StackLayout>
                        <Label Text="Status" FontSize="12" TextColor="Gray" />
                        <Frame BackgroundColor="#2196F3" Padding="10,5" CornerRadius="15" HorizontalOptions="Start">
                            <Label Text="{Binding Venda.StatusDescricao}" 
                                   FontSize="12" 
                                   TextColor="White" 
                                   FontAttributes="Bold" />
                        </Frame>
                    </StackLayout>

                    <!-- Erros de Validação -->
                    <Label Text="{Binding ValidationErrors}" 
                           TextColor="Red" 
                           FontSize="12"
                           IsVisible="{Binding ValidationErrors, Converter={StaticResource StringToBoolConverter}}" />
                </StackLayout>
            </Frame>

            <!-- Seleção de Cliente -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20" Margin="0,10,0,0">
                <StackLayout Spacing="15">
                    <Label Text="👤 Cliente" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#333" />

                    <!-- Busca de Cliente -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <SearchBar Grid.Column="0"
                                   Text="{Binding SearchClienteText}"
                                   Placeholder="Buscar cliente..."
                                   SearchCommand="{Binding SearchClienteCommand}"
                                   BackgroundColor="#F5F5F5" />
                        
                        <Button Grid.Column="1"
                                Text="🔍"
                                Command="{Binding SearchClienteCommand}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                WidthRequest="50" />
                    </Grid>

                    <!-- Lista de Clientes -->
                    <CollectionView ItemsSource="{Binding Clientes}"
                                    SelectedItem="{Binding ClienteSelecionado}"
                                    SelectionMode="Single"
                                    HeightRequest="150"
                                    BackgroundColor="#F5F5F5">
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ClienteLocal">
                                <Grid Padding="10" BackgroundColor="White" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding Nome}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="#333" />
                                        <Label Text="{Binding Email}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                    </StackLayout>
                                    
                                    <Label Grid.Column="1"
                                           Text="✓" 
                                           FontSize="18" 
                                           TextColor="#4CAF50"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ClienteSelecionado, Converter={StaticResource BoolToColorConverter}, ConverterParameter={x:Reference}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Adicionar Produto -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20" Margin="0,10,0,0">
                <StackLayout Spacing="15">
                    <Label Text="🛒 Adicionar Produto" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#333" />

                    <!-- Busca de Produto -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <SearchBar Grid.Column="0"
                                   Text="{Binding SearchProdutoText}"
                                   Placeholder="Buscar produto..."
                                   SearchCommand="{Binding SearchProdutoCommand}"
                                   BackgroundColor="#F5F5F5" />
                        
                        <Button Grid.Column="1"
                                Text="🔍"
                                Command="{Binding SearchProdutoCommand}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                WidthRequest="50" />
                    </Grid>

                    <!-- Lista de Produtos -->
                    <CollectionView ItemsSource="{Binding Produtos}"
                                    SelectedItem="{Binding ProdutoSelecionado}"
                                    SelectionMode="Single"
                                    HeightRequest="120"
                                    BackgroundColor="#F5F5F5">
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProdutoLocal">
                                <Grid Padding="10" BackgroundColor="White" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackLayout Grid.Column="0">
                                        <Label Text="{Binding Nome}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="#333" />
                                        <Label Text="{Binding Codigo}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                    </StackLayout>
                                    
                                    <StackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding PrecoVenda, StringFormat='{0:C2}'}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="#4CAF50" />
                                        <Label Text="{Binding EstoqueFormatado}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                    </StackLayout>
                                    
                                    <Label Grid.Column="2"
                                           Text="✓" 
                                           FontSize="18" 
                                           TextColor="#4CAF50"
                                           VerticalOptions="Center"
                                           Margin="10,0,0,0"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProdutoSelecionado, Converter={StaticResource BoolToColorConverter}, ConverterParameter={x:Reference}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Quantidade e Preço -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" IsVisible="{Binding ProdutoSelecionado, Converter={StaticResource BoolToColorConverter}}">
                        <StackLayout Grid.Column="0">
                            <Label Text="Quantidade" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding QuantidadeProduto}" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White" />
                        </StackLayout>
                        
                        <StackLayout Grid.Column="1">
                            <Label Text="Preço Unitário" FontSize="12" TextColor="Gray" />
                            <Entry Text="{Binding PrecoProduto}" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White" />
                        </StackLayout>
                        
                        <Button Grid.Column="2"
                                Text="Adicionar"
                                Command="{Binding AdicionarItemCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="8"
                                VerticalOptions="End"
                                IsEnabled="{Binding CanAddItem}" />
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Lista de Itens -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20" Margin="0,10,0,0"
                   IsVisible="{Binding HasItens}">
                <StackLayout Spacing="15">
                    <Label Text="📦 Itens da Venda" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#333" />

                    <CollectionView ItemsSource="{Binding Itens}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:VendaItemLocal">
                                <Frame BackgroundColor="#F5F5F5" 
                                       CornerRadius="8" 
                                       Padding="15" 
                                       Margin="0,5">
                                    
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                        <!-- Produto e Quantidade -->
                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                            <Label Text="{Binding Produto.Nome}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#333" />
                                            
                                            <StackLayout Orientation="Horizontal" Spacing="15">
                                                <Label Text="{Binding QuantidadeFormatada}" 
                                                       FontSize="12" 
                                                       TextColor="Gray" />
                                                <Label Text="{Binding PrecoUnitarioFormatado}" 
                                                       FontSize="12" 
                                                       TextColor="Gray" />
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Ações -->
                                        <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Button Text="✏️" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#FF9800"
                                                    FontSize="16"
                                                    WidthRequest="40"
                                                    HeightRequest="40" />
                                            
                                            <Button Text="🗑️" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoverItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    WidthRequest="40"
                                                    HeightRequest="40" />
                                        </StackLayout>

                                        <!-- Total do Item -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding ValorTotalFormatado}" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="#4CAF50"
                                               HorizontalOptions="End"
                                               Margin="0,10,0,0" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Totais da Venda -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20" Margin="0,10,0,0"
                   IsVisible="{Binding HasItens}">
                <StackLayout Spacing="15">
                    <Label Text="💰 Totais" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#333" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <!-- Subtotal -->
                        <StackLayout Grid.Column="0">
                            <Label Text="Subtotal" 
                                   FontSize="12" 
                                   TextColor="Gray" />
                            <Label Text="{Binding Venda.SubTotal, StringFormat='{0:C2}'}" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#333" />
                        </StackLayout>
                        
                        <!-- Desconto -->
                        <StackLayout Grid.Column="1">
                            <Label Text="Desconto" 
                                   FontSize="12" 
                                   TextColor="Gray" />
                            <Entry Text="{Binding Venda.ValorDesconto}" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White" />
                        </StackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                        <!-- Frete -->
                        <StackLayout Grid.Column="0">
                            <Label Text="Frete" 
                                   FontSize="12" 
                                   TextColor="Gray" />
                            <Entry Text="{Binding Venda.ValorFrete}" 
                                   Keyboard="Numeric"
                                   BackgroundColor="White" />
                        </StackLayout>
                        
                        <!-- Total -->
                        <StackLayout Grid.Column="1">
                            <Label Text="Total" 
                                   FontSize="12" 
                                   TextColor="Gray" />
                            <Label Text="{Binding Venda.ValorTotal, StringFormat='{0:C2}'}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#4CAF50" />
                        </StackLayout>
                    </Grid>

                    <!-- Forma de Pagamento -->
                    <StackLayout>
                        <Label Text="Forma de Pagamento" FontSize="12" TextColor="Gray" />
                        <Picker ItemsSource="{Binding FormaPagamentoOptions}"
                                SelectedItem="{Binding Venda.FormaPagamento}"
                                BackgroundColor="White" />
                    </StackLayout>

                    <!-- Observações -->
                    <StackLayout>
                        <Label Text="Observações" FontSize="12" TextColor="Gray" />
                        <Editor Text="{Binding Venda.Observacoes}" 
                                HeightRequest="80"
                                BackgroundColor="White" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Ações -->
            <Frame BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="20" Margin="0,10,0,20">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button Grid.Column="0"
                            Text="Cancelar Venda"
                            Command="{Binding CancelarVendaCommand}"
                            BackgroundColor="#F44336"
                            TextColor="White"
                            CornerRadius="8"
                            IsVisible="{Binding Venda.PodeCancelar}" />
                    
                    <Button Grid.Column="1"
                            Text="Salvar"
                            Command="{Binding SalvarVendaCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="8"
                            IsEnabled="{Binding CanSave}" />
                </Grid>
            </Frame>

        </StackLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#80000000">
        <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
            <Frame BackgroundColor="White" CornerRadius="10" Padding="30">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#2196F3" />
                    <Label Text="Processando..." FontSize="16" TextColor="#333" VerticalOptions="Center" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </Grid>

</ContentPage>