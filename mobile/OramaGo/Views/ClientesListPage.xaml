<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="OramaGo.Views.ClientesListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OramaGo.Models"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sincronizar" 
                     Command="{Binding SyncClientesCommand}" 
                     IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                     IconImageSource="sync.png" />
        <ToolbarItem Text="Adicionar" 
                     Command="{Binding AddClienteCommand}" 
                     IsEnabled="{Binding CanAddCliente}"
                     IconImageSource="add.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Barra de Pesquisa -->
        <Frame Grid.Row="0" BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <SearchBar Grid.Column="0"
                           Text="{Binding SearchText}"
                           Placeholder="Buscar por nome, CPF/CNPJ, email..."
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent" />
                
                <Button Grid.Column="1"
                        Text="🔍"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#2196F3"
                        FontSize="18"
                        WidthRequest="40" />
                
                <Button Grid.Column="2"
                        Text="✕"
                        Command="{Binding ClearSearchCommand}"
                        BackgroundColor="Transparent"
                        TextColor="Gray"
                        FontSize="16"
                        WidthRequest="40" />
            </Grid>
        </Frame>

        <!-- Lista de Clientes -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsRefreshing}" 
                     Command="{Binding RefreshCommand}">
            
            <CollectionView ItemsSource="{Binding ClientesFiltrados}"
                            BackgroundColor="Transparent">
                
                <CollectionView.EmptyView>
                    <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                        <Label Text="👥" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               TextColor="Gray" />
                        <Label Text="{Binding StatusMessage}" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               TextColor="Gray" 
                               HorizontalTextAlignment="Center" />
                        <Button Text="Adicionar Primeiro Cliente" 
                                Command="{Binding AddClienteCommand}"
                                IsVisible="{Binding CanAddCliente}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="0,20,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ClienteLocal">
                        <Grid Padding="15,5">
                            <Frame BackgroundColor="White" 
                                   HasShadow="True" 
                                   CornerRadius="10" 
                                   Padding="0">
                                
                                <Grid RowDefinitions="Auto,Auto,Auto" 
                                      ColumnDefinitions="*,Auto" 
                                      Padding="15">

                                    <!-- Nome e Status -->
                                    <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <Label Text="{Binding Nome}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="#333" 
                                               VerticalOptions="Center" />
                                        
                                        <!-- Status de Bloqueio -->
                                        <Frame BackgroundColor="{Binding Bloqueado, Converter={StaticResource BoolToColorConverter}}"
                                               Padding="8,4"
                                               CornerRadius="12"
                                               IsVisible="{Binding Bloqueado}">
                                            <Label Text="BLOQUEADO" 
                                                   FontSize="10" 
                                                   TextColor="White" 
                                                   FontAttributes="Bold" />
                                        </Frame>
                                        
                                        <!-- Status de Sincronização -->
                                        <Frame BackgroundColor="{Binding StatusSync, Converter={StaticResource SyncStatusToColorConverter}}"
                                               Padding="6,3"
                                               CornerRadius="10"
                                               IsVisible="{Binding StatusSync, Converter={StaticResource SyncStatusToVisibilityConverter}}">
                                            <Label Text="{Binding StatusSync, Converter={StaticResource SyncStatusToIconConverter}}" 
                                                   FontSize="10" 
                                                   TextColor="White" 
                                                   FontAttributes="Bold" />
                                        </Frame>
                                    </StackLayout>

                                    <!-- Botões de Ação -->
                                    <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <Button Text="📞" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CallClienteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#4CAF50"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                IsVisible="{Binding TelefoneCompleto, Converter={StaticResource StringToBoolConverter}}" />
                                        
                                        <Button Text="✉️" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EmailClienteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#2196F3"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                IsVisible="{Binding Email, Converter={StaticResource StringToBoolConverter}}" />
                                    </StackLayout>

                                    <!-- Informações do Cliente -->
                                    <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
                                        <Label Text="{Binding CpfCnpjFormatado}" 
                                               FontSize="14" 
                                               TextColor="Gray"
                                               IsVisible="{Binding CpfCnpj, Converter={StaticResource StringToBoolConverter}}" />
                                        
                                        <Label Text="{Binding Email}" 
                                               FontSize="14" 
                                               TextColor="Gray"
                                               IsVisible="{Binding Email, Converter={StaticResource StringToBoolConverter}}" />
                                        
                                        <Label Text="{Binding TelefoneCompleto}" 
                                               FontSize="14" 
                                               TextColor="Gray"
                                               IsVisible="{Binding TelefoneCompleto, Converter={StaticResource StringToBoolConverter}}" />
                                    </StackLayout>

                                    <!-- Informações Financeiras -->
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" 
                                          ColumnDefinitions="*,*" 
                                          Margin="0,10,0,0">
                                        
                                        <StackLayout Grid.Column="0">
                                            <Label Text="Limite de Crédito" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <Label Text="{Binding LimiteCredito, StringFormat='{0:C2}'}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#4CAF50" />
                                        </StackLayout>
                                        
                                        <StackLayout Grid.Column="1">
                                            <Label Text="Crédito Disponível" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <Label Text="{Binding CreditoDisponivel, StringFormat='{0:C2}'}" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{Binding CreditoDisponivel, Converter={StaticResource CreditoToColorConverter}}" />
                                        </StackLayout>
                                    </Grid>

                                    <!-- Gestos -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewClienteCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Status Bar -->
        <Frame Grid.Row="2" 
               BackgroundColor="#2196F3" 
               HasShadow="True" 
               CornerRadius="0" 
               Padding="15,10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding StatusMessage}" 
                       TextColor="White" 
                       FontSize="14" 
                       VerticalOptions="Center" />
                
                <ActivityIndicator Grid.Column="1"
                                   IsVisible="{Binding IsBusy}" 
                                   IsRunning="{Binding IsBusy}" 
                                   Color="White" />
            </Grid>
        </Frame>
    </Grid>

</ContentPage>