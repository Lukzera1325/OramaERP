<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="OramaGo.Views.VendasListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OramaGo.Models"
             xmlns:converters="clr-namespace:OramaGo.Converters"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nova Venda" 
                     Command="{Binding CreateVendaCommand}" 
                     IconImageSource="add.png"
                     IsEnabled="{Binding CanCreate}" />
        <ToolbarItem Text="Filtros" 
                     Command="{Binding ClearFiltersCommand}" 
                     IconImageSource="filter.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Filtros -->
        <Frame Grid.Row="0" BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15" Margin="0,0,0,5">
            <StackLayout Spacing="15">
                
                <!-- Busca -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <SearchBar Grid.Column="0"
                               Text="{Binding SearchText}"
                               Placeholder="Buscar por número, cliente..."
                               SearchCommand="{Binding SearchVendasCommand}"
                               BackgroundColor="#F5F5F5" />
                    
                    <Button Grid.Column="1"
                            Text="🔍"
                            Command="{Binding SearchVendasCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            WidthRequest="50" />
                </Grid>

                <!-- Filtros de Data e Status -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackLayout Grid.Column="0">
                        <Label Text="Data Início" FontSize="12" TextColor="Gray" />
                        <DatePicker Date="{Binding DataInicio}" BackgroundColor="White" />
                    </StackLayout>
                    
                    <StackLayout Grid.Column="1">
                        <Label Text="Data Fim" FontSize="12" TextColor="Gray" />
                        <DatePicker Date="{Binding DataFim}" BackgroundColor="White" />
                    </StackLayout>
                    
                    <StackLayout Grid.Column="2">
                        <Label Text="Status" FontSize="12" TextColor="Gray" />
                        <Picker ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding StatusFiltro}"
                                BackgroundColor="White">
                            <Picker.ItemDisplayBinding>
                                <Binding>
                                    <Binding.Converter>
                                        <converters:StatusVendaToStringConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </StackLayout>
                </Grid>

            </StackLayout>
        </Frame>

        <!-- Resumo -->
        <Frame Grid.Row="1" BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15" Margin="0,0,0,5">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="Total de Vendas" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />
                    <Label Text="{Binding TotalVendas}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#2196F3"
                           HorizontalOptions="Center" />
                </StackLayout>
                
                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="Valor Total" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" />
                    <Label Text="{Binding ValorTotalVendas, StringFormat='{0:C2}'}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#4CAF50"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Lista de Vendas -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding ReloadDataCommand}">
            
            <CollectionView ItemsSource="{Binding Vendas}"
                            SelectedItem="{Binding VendaSelecionada}"
                            SelectionMode="Single"
                            BackgroundColor="Transparent">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:VendaLocal">
                        <Frame BackgroundColor="White" 
                               CornerRadius="8" 
                               Padding="15" 
                               Margin="10,5"
                               HasShadow="True">
                            
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                
                                <!-- Cabeçalho -->
                                <StackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{Binding Numero}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="#333" />
                                    
                                    <Label Text="{Binding Cliente.Nome}" 
                                           FontSize="14" 
                                           TextColor="#666" />
                                </StackLayout>

                                <!-- Status -->
                                <Frame Grid.Row="0" Grid.Column="1" 
                                       Padding="8,4" 
                                       CornerRadius="12" 
                                       HorizontalOptions="End"
                                       VerticalOptions="Start">
                                    <Frame.BackgroundColor>
                                        <Binding Path="Status">
                                            <Binding.Converter>
                                                <converters:StatusVendaToColorConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Frame.BackgroundColor>
                                    
                                    <Label Text="{Binding StatusDescricao}" 
                                           FontSize="12" 
                                           TextColor="White" 
                                           FontAttributes="Bold" />
                                </Frame>

                                <!-- Informações -->
                                <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Orientation="Horizontal" 
                                             Spacing="20" 
                                             Margin="0,10,0,0">
                                    
                                    <Label Text="{Binding DataVenda, StringFormat='📅 {0:dd/MM/yyyy}'}" 
                                           FontSize="12" 
                                           TextColor="Gray" />
                                    
                                    <Label Text="{Binding QuantidadeItens, StringFormat='📦 {0} itens'}" 
                                           FontSize="12" 
                                           TextColor="Gray" />
                                    
                                    <Label Text="{Binding ValorTotalFormatado, StringFormat='💰 {0}'}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#4CAF50" />
                                </StackLayout>

                                <!-- Ações -->
                                <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                             Orientation="Horizontal" 
                                             Spacing="10" 
                                             Margin="0,15,0,0"
                                             HorizontalOptions="End">
                                    
                                    <Button Text="👁️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewVendaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#2196F3"
                                            FontSize="16"
                                            WidthRequest="40"
                                            HeightRequest="40" />
                                    
                                    <Button Text="✏️" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditVendaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#FF9800"
                                            FontSize="16"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            IsVisible="{Binding PodeEditar}" />
                                    
                                    <Button Text="✅" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AprovarVendaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#4CAF50"
                                            FontSize="16"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            IsVisible="{Binding PodeAprovar}" />
                                    
                                    <Button Text="❌" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteVendaCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#F44336"
                                            FontSize="16"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            IsVisible="{Binding PodeCancelar}" />
                                </StackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="50">
                        <Label Text="📋" FontSize="48" HorizontalOptions="Center" />
                        <Label Text="Nenhuma venda encontrada" 
                               FontSize="16" 
                               TextColor="Gray" 
                               HorizontalOptions="Center" />
                        <Label Text="Toque em 'Nova Venda' para começar" 
                               FontSize="14" 
                               TextColor="Gray" 
                               HorizontalOptions="Center" 
                               Margin="0,5,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>
                
            </CollectionView>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="4" 
              IsVisible="{Binding IsBusy}" 
              BackgroundColor="#80000000">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Frame BackgroundColor="White" CornerRadius="10" Padding="30">
                    <StackLayout Orientation="Horizontal" Spacing="15">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#2196F3" />
                        <Label Text="Carregando vendas..." FontSize="16" TextColor="#333" VerticalOptions="Center" />
                    </StackLayout>
                </Frame>
            </StackLayout>
        </Grid>

    </Grid>

</ContentPage>