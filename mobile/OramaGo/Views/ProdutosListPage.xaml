<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="OramaGo.Views.ProdutosListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OramaGo.Models"
             xmlns:converters="clr-namespace:OramaGo.Converters"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:EstoqueToColorConverter x:Key="EstoqueToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adicionar" 
                     Command="{Binding AddProdutoCommand}" 
                     IconImageSource="add.png"
                     IsEnabled="{Binding CanAddProduto}" />
        <ToolbarItem Text="Filtros" 
                     Command="{Binding ClearSearchCommand}" 
                     IconImageSource="filter.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Barra de Busca -->
        <Frame Grid.Row="0" BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <SearchBar Grid.Column="0"
                           Text="{Binding SearchText}"
                           Placeholder="Buscar por nome, código ou categoria..."
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="#F5F5F5" />
                
                <Button Grid.Column="1"
                        Text="🔍"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="50" />
            </Grid>
        </Frame>

        <!-- Filtros -->
        <Frame Grid.Row="1" BackgroundColor="White" HasShadow="True" CornerRadius="0" Padding="15">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                
                <!-- Filtro por Categoria -->
                <StackLayout Grid.Column="0">
                    <Label Text="Categoria" FontSize="12" TextColor="Gray" />
                    <Picker ItemsSource="{Binding Categorias}"
                            SelectedItem="{Binding SelectedCategoria}"
                            BackgroundColor="#F5F5F5"
                            TextColor="#333" />
                </StackLayout>

                <!-- Filtro Disponível -->
                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding ShowOnlyAvailable}" Color="#2196F3" />
                    <Label Text="Apenas disponíveis" FontSize="14" TextColor="#333" VerticalOptions="Center" />
                </StackLayout>

                <!-- Botão Limpar -->
                <Button Grid.Column="2"
                        Text="Limpar"
                        Command="{Binding ClearSearchCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"
                        CornerRadius="8"
                        WidthRequest="80" />
            </Grid>
        </Frame>

        <!-- Lista de Produtos -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding LoadDataCommand}"
                     RefreshColor="#2196F3">
            
            <CollectionView ItemsSource="{Binding ProdutosFiltrados}"
                            BackgroundColor="Transparent">
                
                <CollectionView.EmptyView>
                    <StackLayout Padding="40" VerticalOptions="CenterAndExpand">
                        <Label Text="📦" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               TextColor="Gray" />
                        <Label Text="{Binding StatusMessage}" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               TextColor="Gray" 
                               HorizontalTextAlignment="Center" />
                        <Button Text="Adicionar Primeiro Produto" 
                                Command="{Binding AddProdutoCommand}"
                                IsVisible="{Binding CanAddProduto}"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                CornerRadius="8"
                                Margin="0,20,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProdutoLocal">
                        <Grid Padding="15,5">
                            <Frame BackgroundColor="White" 
                                   HasShadow="True" 
                                   CornerRadius="10" 
                                   Padding="0">
                                
                                <Grid RowDefinitions="Auto,Auto,Auto" 
                                      ColumnDefinitions="80,*,Auto" 
                                      Padding="15">

                                    <!-- Imagem do Produto -->
                                    <Frame Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                           BackgroundColor="#F5F5F5"
                                           CornerRadius="8"
                                           Padding="10"
                                           WidthRequest="70"
                                           HeightRequest="70"
                                           VerticalOptions="Center">
                                        <Label Text="📦" 
                                               FontSize="24" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"
                                               TextColor="#2196F3" />
                                    </Frame>

                                    <!-- Nome e Código -->
                                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Nome}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" 
                                               TextColor="#333" />
                                        
                                        <StackLayout Orientation="Horizontal" Spacing="10">
                                            <Label Text="{Binding Codigo}" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            
                                            <Frame BackgroundColor="{Binding EstoqueAtual, Converter={StaticResource EstoqueToColorConverter}}"
                                                   Padding="6,2"
                                                   CornerRadius="10">
                                                <Label Text="{Binding EstoqueStatus}" 
                                                       FontSize="10" 
                                                       TextColor="White" 
                                                       FontAttributes="Bold" />
                                            </Frame>
                                        </StackLayout>
                                    </StackLayout>

                                    <!-- Botões de Ação -->
                                    <StackLayout Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                        <Button Text="👁️" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewProdutoCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#2196F3"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40" />
                                        
                                        <Button Text="✏️" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditProdutoCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent"
                                                TextColor="#FF9800"
                                                FontSize="16"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CanEditProduto}" />
                                    </StackLayout>

                                    <!-- Categoria e Descrição -->
                                    <StackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
                                        <Label Text="{Binding Categoria}" 
                                               FontSize="12" 
                                               TextColor="#2196F3"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding Categoria, Converter={StaticResource StringToBoolConverter}}" />
                                        
                                        <Label Text="{Binding Descricao}" 
                                               FontSize="12" 
                                               TextColor="Gray"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               IsVisible="{Binding Descricao, Converter={StaticResource StringToBoolConverter}}" />
                                    </StackLayout>

                                    <!-- Preço e Estoque -->
                                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                                          ColumnDefinitions="*,*" 
                                          ColumnSpacing="20" 
                                          Margin="0,10,0,0">
                                        
                                        <StackLayout Grid.Column="0">
                                            <Label Text="Preço de Venda" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <Label Text="{Binding PrecoVenda, StringFormat='{0:C2}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#4CAF50" />
                                        </StackLayout>
                                        
                                        <StackLayout Grid.Column="1">
                                            <Label Text="Estoque Atual" 
                                                   FontSize="12" 
                                                   TextColor="Gray" />
                                            <Label Text="{Binding EstoqueAtual, StringFormat='{0:N2}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{Binding EstoqueAtual, Converter={StaticResource EstoqueToColorConverter}}" />
                                        </StackLayout>
                                    </Grid>

                                    <!-- Gestos -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewProdutoCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Status Bar -->
        <Frame Grid.Row="3" 
               BackgroundColor="#2196F3" 
               HasShadow="False" 
               CornerRadius="0" 
               Padding="15,10">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding StatusMessage}" 
                       TextColor="White" 
                       FontSize="14" 
                       VerticalOptions="Center" />
                
                <ActivityIndicator Grid.Column="1"
                                   IsVisible="{Binding IsBusy}" 
                                   IsRunning="{Binding IsBusy}" 
                                   Color="White" />
            </Grid>
        </Frame>

    </Grid>

</ContentPage>