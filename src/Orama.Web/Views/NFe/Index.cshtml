@model List<Orama.Domain.Entities.Fiscal.NFe.NFeDocumento>
@{
    ViewData["Title"] = "NF-e - Notas Fiscais Eletrônicas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-file-invoice"></i>
                        NF-e - Notas Fiscais Eletrônicas
                    </h3>
                    <div class="btn-group">
                        <button type="button" class="btn btn-info btn-sm" onclick="verificarStatusServico()">
                            <i class="fas fa-server"></i>
                            Status SEFAZ
                        </button>
                        <form method="post" asp-action="AtualizarStatusPendentes" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm">
                                <i class="fas fa-sync"></i>
                                Atualizar Pendentes
                            </button>
                        </form>
                    </div>
                </div>
                
                <div class="card-body">
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle"></i>
                            @TempData["Sucesso"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-triangle"></i>
                            @TempData["Erro"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    <!-- Filtros -->
                    <form method="get" class="mb-3">
                        <div class="row">
                            <div class="col-md-4">
                                <label for="dataInicio">Data Início:</label>
                                <input type="date" id="dataInicio" name="dataInicio" class="form-control" 
                                       value="@ViewBag.DataInicio" />
                            </div>
                            <div class="col-md-4">
                                <label for="dataFim">Data Fim:</label>
                                <input type="date" id="dataFim" name="dataFim" class="form-control" 
                                       value="@ViewBag.DataFim" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i>
                                    Filtrar
                                </button>
                            </div>
                        </div>
                    </form>
                    
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Número</th>
                                        <th>Série</th>
                                        <th>Chave de Acesso</th>
                                        <th>Data Emissão</th>
                                        <th>Status</th>
                                        <th>Ambiente</th>
                                        <th>Protocolo</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var nfe in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@nfe.Numero.ToString("D9")</strong>
                                            </td>
                                            <td>@nfe.Serie</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(nfe.ChaveAcesso))
                                                {
                                                    <code class="small">@nfe.ChaveAcesso</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@nfe.DataEmissao.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @{
                                                    var badgeClass = nfe.Status switch
                                                    {
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Autorizada => "success",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Cancelada => "secondary",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Rejeitada => "danger",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Enviada => "warning",
                                                        _ => "info"
                                                    };
                                                }
                                                <span class="badge badge-@badgeClass">
                                                    @nfe.Status
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-@(nfe.AmbienteFiscal == Orama.Domain.Entities.Fiscal.AmbienteFiscal.Producao ? "success" : "secondary")">
                                                    @nfe.AmbienteFiscal
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(nfe.ProtocoloAutorizacao))
                                                {
                                                    <small>@nfe.ProtocoloAutorizacao</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Detalhes", new { id = nfe.Id })" 
                                                       class="btn btn-outline-primary" title="Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    
                                                    @if (nfe.Status == Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Gerada || nfe.Status == Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Rascunho)
                                                    {
                                                        <form method="post" asp-action="EnviarNFe" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@nfe.Id" />
                                                            <button type="submit" class="btn btn-outline-success" 
                                                                    title="Enviar" onclick="return confirm('Confirma o envio da NF-e?')">
                                                                <i class="fas fa-paper-plane"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    
                                                    @if (nfe.PodeConsultar())
                                                    {
                                                        <form method="post" asp-action="ConsultarNFe" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@nfe.Id" />
                                                            <button type="submit" class="btn btn-outline-info" title="Consultar">
                                                                <i class="fas fa-search"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    
                                                    @if (!string.IsNullOrEmpty(nfe.XmlAssinado) || !string.IsNullOrEmpty(nfe.XmlGerado))
                                                    {
                                                        <a href="@Url.Action("DownloadXml", new { id = nfe.Id })" 
                                                           class="btn btn-outline-secondary" title="Download XML">
                                                            <i class="fas fa-download"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="mt-3">
                            <small class="text-muted">
                                Total: @Model.Count NF-es encontradas
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma NF-e encontrada</h5>
                            <p class="text-muted">As NF-es são geradas automaticamente a partir das vendas finalizadas.</p>
                            <a href="@Url.Action("Index", "Vendas")" class="btn btn-primary">
                                <i class="fas fa-shopping-cart"></i>
                                Ver Vendas
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Status SEFAZ -->
<div class="modal fade" id="modalStatusSefaz" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Status do Serviço SEFAZ</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="statusSefazContent">
                    <div class="text-center">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2">Verificando status...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
function verificarStatusServico() {
    $('#modalStatusSefaz').modal('show');
    
    fetch('@Url.Action("StatusServico")')
        .then(response => response.json())
        .then(data => {
            let content = '';
            if (data.sucesso) {
                const iconClass = data.disponivel ? 'fa-check-circle text-success' : 'fa-times-circle text-danger';
                const statusText = data.disponivel ? 'Serviço disponível' : 'Serviço indisponível';
                
                content = `
                    <div class="text-center">
                        <i class="fas ${iconClass} fa-3x mb-3"></i>
                        <h5>${statusText}</h5>
                        <p class="text-muted">Status: ${data.statusServico}</p>
                    </div>
                `;
            } else {
                content = `
                    <div class="text-center">
                        <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                        <h5>Erro ao verificar status</h5>
                        <p class="text-muted">${data.erro}</p>
                    </div>
                `;
            }
            
            document.getElementById('statusSefazContent').innerHTML = content;
        })
        .catch(error => {
            document.getElementById('statusSefazContent').innerHTML = `
                <div class="text-center">
                    <i class="fas fa-exclamation-triangle text-danger fa-3x mb-3"></i>
                    <h5>Erro de conexão</h5>
                    <p class="text-muted">Não foi possível verificar o status do serviço</p>
                </div>
            `;
        });
}
</script>