@model Orama.Domain.Entities.Fiscal.NFe.NFeDocumento
@{
    ViewData["Title"] = $"NF-e {Model.Numero.ToString("D9")} - Detalhes";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-file-invoice"></i>
                        NF-e @Model.Numero.ToString("D9") - Detalhes
                    </h3>
                    <div class="btn-group">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i>
                            Voltar
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle"></i>
                            @TempData["Sucesso"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-triangle"></i>
                            @TempData["Erro"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    <!-- Informações Gerais -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-info-circle"></i>
                                        Informações Gerais
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr>
                                            <td><strong>Número:</strong></td>
                                            <td>@Model.Numero.ToString("D9")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Série:</strong></td>
                                            <td>@Model.Serie</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Data Emissão:</strong></td>
                                            <td>@Model.DataEmissao.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>
                                                @{
                                                    var badgeClass = Model.Status switch
                                                    {
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Autorizada => "success",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Cancelada => "secondary",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Rejeitada => "danger",
                                                        Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Enviada => "warning",
                                                        _ => "info"
                                                    };
                                                }
                                                <span class="badge badge-@badgeClass">
                                                    @Model.Status
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ambiente:</strong></td>
                                            <td>
                                                <span class="badge badge-@(Model.AmbienteFiscal == Orama.Domain.Entities.Fiscal.AmbienteFiscal.Producao ? "success" : "secondary")">
                                                    @Model.AmbienteFiscal
                                                </span>
                                            </td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(Model.ProtocoloAutorizacao))
                                        {
                                            <tr>
                                                <td><strong>Protocolo:</strong></td>
                                                <td><code>@Model.ProtocoloAutorizacao</code></td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.MensagemSefaz))
                                        {
                                            <tr>
                                                <td><strong>Mensagem SEFAZ:</strong></td>
                                                <td>@Model.MensagemSefaz</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-key"></i>
                                        Chave de Acesso
                                    </h5>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(Model.ChaveAcesso))
                                    {
                                        <div class="form-group">
                                            <label>Chave de Acesso (44 dígitos):</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control font-monospace" 
                                                       value="@Model.ChaveAcesso" readonly />
                                                <div class="input-group-append">
                                                    <button class="btn btn-outline-secondary" type="button" 
                                                            onclick="copiarChave()" title="Copiar">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Formatação visual da chave -->
                                        <div class="mt-3">
                                            <small class="text-muted">Chave formatada:</small>
                                            <div class="bg-light p-2 rounded font-monospace small">
                                                @{
                                                    var chave = Model.ChaveAcesso;
                                                    var chaveFormatada = $"{chave.Substring(0, 4)} {chave.Substring(4, 4)} {chave.Substring(8, 4)} {chave.Substring(12, 4)} {chave.Substring(16, 4)} {chave.Substring(20, 4)} {chave.Substring(24, 4)} {chave.Substring(28, 4)} {chave.Substring(32, 4)} {chave.Substring(36, 4)} {chave.Substring(40, 4)}";
                                                }
                                                @chaveFormatada
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">Chave de acesso não gerada</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Ações -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-cogs"></i>
                                        Ações Disponíveis
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="btn-group" role="group">
                                        @if (Model.Status == Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Gerada || Model.Status == Orama.Domain.Entities.Fiscal.NFe.NFeStatus.Rascunho)
                                        {
                                            <form method="post" asp-action="EnviarNFe" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <button type="submit" class="btn btn-success" 
                                                        onclick="return confirm('Confirma o envio da NF-e para a SEFAZ?')">
                                                    <i class="fas fa-paper-plane"></i>
                                                    Enviar para SEFAZ
                                                </button>
                                            </form>
                                        }
                                        
                                        @if (Model.PodeConsultar())
                                        {
                                            <form method="post" asp-action="ConsultarNFe" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <button type="submit" class="btn btn-info">
                                                    <i class="fas fa-search"></i>
                                                    Consultar Status
                                                </button>
                                            </form>
                                        }
                                        
                                        @if (ViewBag.PodeCancelar == true)
                                        {
                                            <button type="button" class="btn btn-warning" data-toggle="modal" data-target="#modalCancelamento">
                                                <i class="fas fa-ban"></i>
                                                Cancelar NF-e
                                            </button>
                                        }
                                        else if (ViewBag.PodeCancelar == false && !string.IsNullOrEmpty(ViewBag.MotivoCancelamento))
                                        {
                                            <button type="button" class="btn btn-secondary" disabled title="@ViewBag.MotivoCancelamento">
                                                <i class="fas fa-ban"></i>
                                                Não Pode Cancelar
                                            </button>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(Model.XmlAssinado) || !string.IsNullOrEmpty(Model.XmlGerado))
                                        {
                                            <a href="@Url.Action("DownloadXml", new { id = Model.Id })" 
                                               class="btn btn-outline-primary">
                                                <i class="fas fa-download"></i>
                                                Download XML
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Itens da NF-e -->
                    @if (Model.Itens.Any())
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-list"></i>
                                            Itens da NF-e
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Item</th>
                                                        <th>Descrição</th>
                                                        <th>NCM</th>
                                                        <th>CFOP</th>
                                                        <th>Qtd</th>
                                                        <th>Valor Unit.</th>
                                                        <th>Valor Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.Itens.OrderBy(i => i.NumeroItem))
                                                    {
                                                        <tr>
                                                            <td>@item.NumeroItem</td>
                                                            <td>@item.Descricao</td>
                                                            <td><code>@item.NCM</code></td>
                                                            <td><code>@item.CFOP</code></td>
                                                            <td>@item.Quantidade.ToString("N2")</td>
                                                            <td>@item.ValorUnitario.ToString("C")</td>
                                                            <td>@item.ValorTotal.ToString("C")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot>
                                                    <tr class="font-weight-bold">
                                                        <td colspan="6">Total da NF-e:</td>
                                                        <td>@Model.Itens.Sum(i => i.ValorTotal).ToString("C")</td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Eventos -->
                    @if (Model.Eventos.Any())
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-history"></i>
                                            Histórico de Eventos
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Data/Hora</th>
                                                        <th>Tipo</th>
                                                        <th>Descrição</th>
                                                        <th>Protocolo</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var evento in Model.Eventos.OrderByDescending(e => e.DataEvento))
                                                    {
                                                        <tr>
                                                            <td>@evento.DataEvento.ToString("dd/MM/yyyy HH:mm")</td>
                                                            <td>
                                                                <span class="badge badge-info">@evento.TipoEvento</span>
                                                            </td>
                                                            <td>@evento.Descricao</td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(evento.Protocolo))
                                                                {
                                                                    <code class="small">@evento.Protocolo</code>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">-</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cancelamento -->
<div class="modal fade" id="modalCancelamento" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CancelarNFe">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="modal-header">
                    <h5 class="modal-title">Cancelar NF-e @Model.Numero.ToString("D9")</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>
                
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Atenção!</strong> O cancelamento da NF-e é irreversível.
                    </div>
                    
                    <div class="form-group">
                        <label for="justificativa">Justificativa do Cancelamento: <span class="text-danger">*</span></label>
                        <textarea name="justificativa" id="justificativa" class="form-control" 
                                  rows="3" required minlength="15" maxlength="255"
                                  placeholder="Informe o motivo do cancelamento (mínimo 15 caracteres)"></textarea>
                        <small class="form-text text-muted">
                            A justificativa deve ter entre 15 e 255 caracteres.
                        </small>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times"></i>
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-danger" 
                            onclick="return confirm('Confirma o cancelamento da NF-e?')">
                        <i class="fas fa-ban"></i>
                        Confirmar Cancelamento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function copiarChave() {
    const chaveInput = document.querySelector('input[value="@Model.ChaveAcesso"]');
    chaveInput.select();
    chaveInput.setSelectionRange(0, 99999); // Para mobile
    
    try {
        document.execCommand('copy');
        
        // Feedback visual
        const btn = event.target.closest('button');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i>';
        btn.classList.add('btn-success');
        btn.classList.remove('btn-outline-secondary');
        
        setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.classList.remove('btn-success');
            btn.classList.add('btn-outline-secondary');
        }, 2000);
        
    } catch (err) {
        alert('Erro ao copiar chave de acesso');
    }
}
</script>