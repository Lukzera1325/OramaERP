@model IEnumerable<PerfilViewModel>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="text-primary mb-1">
                        <i class="fas fa-users-cog me-2"></i>Perfis de Usuário
                    </h2>
                    <p class="text-muted mb-0">Gerencie os perfis de acesso do sistema</p>
                </div>
                <div>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Novo Perfil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Lista de Perfis -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nome</th>
                                        <th>Descrição</th>
                                        <th class="text-center">Usuários</th>
                                        <th class="text-center">Permissões</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var perfil in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar-sm bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center me-3">
                                                        <i class="fas fa-user-tag text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0">@perfil.Nome</h6>
                                                        <small class="text-muted">
                                                            Criado em @perfil.DataCriacao.ToString("dd/MM/yyyy")
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(perfil.Descricao))
                                                {
                                                    <span>@perfil.Descricao</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Sem descrição</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info">@perfil.QuantidadeUsuarios</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary">@perfil.QuantidadePermissoes</span>
                                            </td>
                                            <td class="text-center">
                                                @if (perfil.Ativo)
                                                {
                                                    <span class="badge bg-success">Ativo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inativo</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = perfil.Id })" 
                                                       class="btn btn-sm btn-outline-info" 
                                                       title="Visualizar">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Permissoes", new { id = perfil.Id })" 
                                                       class="btn btn-sm btn-outline-warning" 
                                                       title="Gerenciar Permissões">
                                                        <i class="fas fa-key"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = perfil.Id })" 
                                                       class="btn btn-sm btn-outline-primary" 
                                                       title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (perfil.PodeExcluir)
                                                    {
                                                        <a href="@Url.Action("Delete", new { id = perfil.Id })" 
                                                           class="btn btn-sm btn-outline-danger" 
                                                           title="Excluir">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-secondary" 
                                                                disabled 
                                                                title="Não pode ser excluído (possui usuários vinculados)">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users-cog fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhum perfil encontrado</h5>
                            <p class="text-muted">Clique em "Novo Perfil" para criar o primeiro perfil.</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Criar Primeiro Perfil
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}