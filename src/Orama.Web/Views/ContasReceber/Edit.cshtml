@model ContaReceberViewModel
@{
    ViewData["Title"] = "Editar Conta a Receber";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Editar Conta a Receber</h2>
        <p class="text-muted mb-0">@Model.Descricao</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Voltar
    </a>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ValorRecebido" />
    <input type="hidden" asp-for="Status" />
    
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Dados da Conta</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Descricao" class="form-label"></label>
                            <input asp-for="Descricao" class="form-control" />
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="NumeroDocumento" class="form-label"></label>
                            <input asp-for="NumeroDocumento" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes">
                                <option value="">Selecione um cliente</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="DataEmissao" class="form-label"></label>
                            <input asp-for="DataEmissao" type="date" class="form-control" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="DataVencimento" class="form-label"></label>
                            <input asp-for="DataVencimento" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorOriginal" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorOriginal" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorJuros" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorJuros" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorMulta" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorMulta" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorDesconto" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorDesconto" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observacoes" class="form-label"></label>
                        <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-@Model.StatusCor text-white">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Status</h6>
                </div>
                <div class="card-body text-center">
                    <span class="badge bg-@Model.StatusCor fs-5">@Model.StatusDescricao</span>
                    <hr>
                    <p class="mb-1"><small class="text-muted">Valor Total:</small></p>
                    <h4>@Model.ValorTotal.ToString("C")</h4>
                    <p class="mb-1"><small class="text-muted">Valor Recebido:</small></p>
                    <h5 class="text-success">@Model.ValorRecebido.ToString("C")</h5>
                    <p class="mb-1"><small class="text-muted">Saldo Devedor:</small></p>
                    <h4 class="text-danger">@Model.SaldoDevedor.ToString("C")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>Salvar Alterações
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
