@model ContaReceberViewModel
@{
    ViewData["Title"] = "Nova Conta a Receber";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-arrow-up text-success me-2"></i>Nova Conta a Receber</h2>
        <p class="text-muted mb-0">Cadastre uma nova conta a receber</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Voltar
    </a>
</div>

<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Dados da Conta</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Descricao" class="form-label"></label>
                            <input asp-for="Descricao" class="form-control" placeholder="Ex: Venda de produtos, Serviço prestado" />
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="NumeroDocumento" class="form-label"></label>
                            <input asp-for="NumeroDocumento" class="form-control" placeholder="Nº NF, Boleto, etc." />
                            <span asp-validation-for="NumeroDocumento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.Clientes">
                                <option value="">Selecione um cliente (opcional)</option>
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="DataEmissao" class="form-label"></label>
                            <input asp-for="DataEmissao" type="date" class="form-control" />
                            <span asp-validation-for="DataEmissao" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="DataVencimento" class="form-label"></label>
                            <input asp-for="DataVencimento" type="date" class="form-control" />
                            <span asp-validation-for="DataVencimento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorOriginal" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorOriginal" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="ValorOriginal" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorJuros" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorJuros" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorMulta" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorMulta" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="ValorDesconto" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorDesconto" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observacoes" class="form-label"></label>
                        <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Observações adicionais..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-lightbulb me-2"></i>Dicas</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Informe a data de vencimento correta</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Vincule a um cliente para melhor controle</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Use o nº do documento para referência</li>
                        <li><i class="fas fa-check text-success me-2"></i>Juros e multa podem ser adicionados depois</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>Salvar Conta
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
