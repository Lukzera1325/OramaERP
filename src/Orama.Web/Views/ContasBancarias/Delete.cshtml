@model ContaBancariaViewModel
@{
    ViewData["Title"] = "Excluir Conta Bancária";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-trash text-danger me-2"></i>Excluir Conta Bancária</h2>
        <p class="text-muted mb-0">Confirme a exclusão da conta</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Voltar
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Atenção!</h5>
    </div>
    <div class="card-body">
        <p class="lead">Tem certeza que deseja excluir esta conta bancária?</p>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <dl>
                    <dt>Descrição</dt>
                    <dd>@Model.Descricao</dd>
                    <dt>Tipo</dt>
                    <dd>@Model.TipoContaDescricao</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl>
                    <dt>Saldo Atual</dt>
                    <dd class="@(Model.SaldoAtual >= 0 ? "text-success" : "text-danger") fw-bold">
                        @Model.SaldoAtual.ToString("C")
                    </dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-info-circle me-2"></i>
            Esta ação não poderá ser desfeita. Contas com movimentações não podem ser excluídas.
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Confirmar Exclusão
                </button>
            </div>
        </form>
    </div>
</div>
