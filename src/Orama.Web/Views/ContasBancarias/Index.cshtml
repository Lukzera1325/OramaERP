@model IEnumerable<ContaBancariaViewModel>
@{
    ViewData["Title"] = "Contas Bancárias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-university me-2"></i>Contas Bancárias</h2>
        <p class="text-muted mb-0">Gerencie suas contas bancárias e caixas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Nova Conta
    </a>
</div>

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Saldo Total</h6>
                        <h3 class="mb-0">@ViewBag.SaldoTotal.ToString("C")</h3>
                    </div>
                    <i class="fas fa-wallet fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Total de Contas</h6>
                        <h3 class="mb-0">@Model.Count()</h3>
                    </div>
                    <i class="fas fa-credit-card fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Conta Padrão</h6>
                        <h5 class="mb-0">@(Model.FirstOrDefault(c => c.ContaPadrao)?.Descricao ?? "Não definida")</h5>
                    </div>
                    <i class="fas fa-star fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-university fa-4x text-muted mb-3"></i>
                <h5>Nenhuma conta bancária cadastrada</h5>
                <p class="text-muted">Cadastre sua primeira conta para começar</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Cadastrar Conta
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Descrição</th>
                            <th>Tipo</th>
                            <th>Banco/Agência/Conta</th>
                            <th class="text-end">Saldo Atual</th>
                            <th class="text-center">Padrão</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conta in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@conta.Descricao</strong>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@conta.TipoContaDescricao</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(conta.Banco))
                                    {
                                        <span>@conta.Banco / @conta.Agencia / @conta.NumeroConta</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <strong class="@(conta.SaldoAtual >= 0 ? "text-success" : "text-danger")">
                                        @conta.SaldoAtual.ToString("C")
                                    </strong>
                                </td>
                                <td class="text-center">
                                    @if (conta.ContaPadrao)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@conta.Id" class="btn btn-outline-info" title="Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@conta.Id" class="btn btn-outline-primary" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@conta.Id" class="btn btn-outline-danger" title="Excluir">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
