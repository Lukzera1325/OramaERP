@model IEnumerable<Orama.Domain.Entities.Venda>
@{
    ViewData["Title"] = "Vendas Mais Lucrativas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <!-- Resumo -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-success text-white">
                                    <div class="card-body text-center">
                                        <h5>Total de Vendas</h5>
                                        <h3>@Model.Count()</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-primary text-white">
                                    <div class="card-body text-center">
                                        <h5>Maior Lucro</h5>
                                        <h3>@Model.Max(v => v.LucroTotal).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white">
                                    <div class="card-body text-center">
                                        <h5>Lucro Total</h5>
                                        <h3>@Model.Sum(v => v.LucroTotal).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white">
                                    <div class="card-body text-center">
                                        <h5>Margem Média</h5>
                                        <h3>@Model.Average(v => v.MargemPercentual).ToString("N1")%</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ranking</th>
                                        <th>Venda</th>
                                        <th>Cliente</th>
                                        <th>Data</th>
                                        <th>Valor Total</th>
                                        <th>Custo Total</th>
                                        <th>Lucro</th>
                                        <th>Margem %</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int ranking = 1;}
                                    @foreach (var venda in Model)
                                    {
                                        <tr class="@(ranking <= 3 ? "table-success" : ranking <= 10 ? "table-info" : "")">
                                            <td>
                                                @if (ranking <= 3)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-trophy"></i> @ranking°
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@ranking°</span>
                                                }
                                            </td>
                                            <td><strong>@venda.Numero</strong></td>
                                            <td>@venda.Cliente.Nome</td>
                                            <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                                            <td>@venda.ValorTotal.ToString("C")</td>
                                            <td>@venda.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="text-success">
                                                    @venda.LucroTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="text-success">
                                                    @venda.MargemPercentual.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>
                                                <a asp-controller="Vendas" asp-action="Detalhes" asp-route-id="@venda.Id" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        ranking++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhuma venda lucrativa encontrada.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar ao Relatório
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-success { background-color: rgba(25, 135, 84, 0.1) !important; }
    .table-info { background-color: rgba(13, 202, 240, 0.1) !important; }
</style>