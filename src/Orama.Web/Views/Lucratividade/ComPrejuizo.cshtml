@model IEnumerable<Orama.Domain.Entities.Venda>
@{
    ViewData["Title"] = "Vendas com Prejuízo";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <!-- Alerta -->
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Atenção!</strong> As vendas abaixo foram realizadas com prejuízo (vendidas abaixo do custo).
                        </div>

                        <!-- Resumo -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-danger text-white">
                                    <div class="card-body text-center">
                                        <h5>Vendas com Prejuízo</h5>
                                        <h3>@Model.Count()</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white">
                                    <div class="card-body text-center">
                                        <h5>Maior Prejuízo</h5>
                                        <h3>@Model.Min(v => v.LucroTotal).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-secondary text-white">
                                    <div class="card-body text-center">
                                        <h5>Prejuízo Total</h5>
                                        <h3>@Model.Sum(v => v.LucroTotal).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white">
                                    <div class="card-body text-center">
                                        <h5>Valor Total Vendido</h5>
                                        <h3>@Model.Sum(v => v.ValorTotal).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Venda</th>
                                        <th>Cliente</th>
                                        <th>Data</th>
                                        <th>Valor Total</th>
                                        <th>Custo Total</th>
                                        <th>Prejuízo</th>
                                        <th>Margem %</th>
                                        <th>Impacto</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var venda in Model)
                                    {
                                        <tr class="table-danger">
                                            <td><strong>@venda.Numero</strong></td>
                                            <td>@venda.Cliente.Nome</td>
                                            <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                                            <td>@venda.ValorTotal.ToString("C")</td>
                                            <td>@venda.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="text-danger">
                                                    @venda.LucroTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="text-danger">
                                                    @venda.MargemPercentual.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>
                                                @{
                                                    var impactoPercentual = Math.Abs(venda.LucroTotal / venda.ValorTotal * 100);
                                                }
                                                @if (impactoPercentual > 20)
                                                {
                                                    <span class="badge bg-danger">Alto</span>
                                                }
                                                else if (impactoPercentual > 10)
                                                {
                                                    <span class="badge bg-warning">Médio</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">Baixo</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Vendas" asp-action="Detalhes" asp-route-id="@venda.Id" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="3">TOTAIS:</th>
                                        <th><strong>@Model.Sum(v => v.ValorTotal).ToString("C")</strong></th>
                                        <th><strong>@Model.Sum(v => v.CustoTotal).ToString("C")</strong></th>
                                        <th><strong class="text-danger">@Model.Sum(v => v.LucroTotal).ToString("C")</strong></th>
                                        <th><strong>@(Model.Sum(v => v.ValorTotal) > 0 ? ((Model.Sum(v => v.LucroTotal) / Model.Sum(v => v.ValorTotal)) * 100).ToString("N1") : "0,0")%</strong></th>
                                        <th colspan="2">-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Recomendações -->
                        <div class="alert alert-info">
                            <h5><i class="fas fa-lightbulb"></i> Recomendações:</h5>
                            <ul class="mb-0">
                                <li>Revisar a política de preços dos produtos com prejuízo</li>
                                <li>Verificar se os custos dos produtos estão atualizados</li>
                                <li>Considerar renegociar com fornecedores para reduzir custos</li>
                                <li>Avaliar se há descontos excessivos sendo aplicados</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i>
                            <strong>Parabéns!</strong> Nenhuma venda com prejuízo encontrada. Todas as vendas estão sendo realizadas com margem positiva.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar ao Relatório
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-danger { background-color: rgba(220, 53, 69, 0.1) !important; }
</style>