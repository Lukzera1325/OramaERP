@model IEnumerable<Orama.Domain.Entities.Venda>
@{
    ViewData["Title"] = "Relatório de Lucratividade";
    var resumo = ViewBag.Resumo;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="dataInicio" class="form-label">Data Início:</label>
                            <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
                        </div>
                        <div class="col-md-4">
                            <label for="dataFim" class="form-label">Data Fim:</label>
                            <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                            <a asp-action="MaisLucrativas" class="btn btn-success me-2">
                                <i class="fas fa-trophy"></i> Top Lucros
                            </a>
                            <a asp-action="ComPrejuizo" class="btn btn-danger">
                                <i class="fas fa-exclamation-triangle"></i> Prejuízos
                            </a>
                        </div>
                    </form>

                    <!-- Resumo Executivo -->
                    <div class="row mb-4">
                        <div class="col-md-2">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>Total Vendas</h5>
                                    <h3>@resumo.TotalVendas</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h5>Valor Total</h5>
                                    <h3>@(((decimal)resumo.ValorTotalVendas).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-secondary text-white">
                                <div class="card-body text-center">
                                    <h5>Custo Total</h5>
                                    <h3>@(((decimal)resumo.CustoTotalVendas).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.LucroTotalVendas >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Lucro Total</h5>
                                    <h3>@(((decimal)resumo.LucroTotalVendas).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.MargemMediaPercentual >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Margem Média</h5>
                                    <h3>@(((decimal)resumo.MargemMediaPercentual).ToString("N1"))%</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h5>Lucro / Prejuízo</h5>
                                    <h6>@resumo.VendasComLucro / @resumo.VendasComPrejuizo</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela de Vendas -->
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Venda</th>
                                        <th>Cliente</th>
                                        <th>Data</th>
                                        <th>Valor Total</th>
                                        <th>Custo Total</th>
                                        <th>Lucro</th>
                                        <th>Margem %</th>
                                        <th>Status</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var venda in Model)
                                    {
                                        <tr class="@(venda.LucroTotal < 0 ? "table-danger" : venda.MargemPercentual > 30 ? "table-success" : "")">
                                            <td>
                                                <strong>@venda.Numero</strong>
                                            </td>
                                            <td>@venda.Cliente.Nome</td>
                                            <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                                            <td>@venda.ValorTotal.ToString("C")</td>
                                            <td>@venda.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="@(venda.LucroTotal >= 0 ? "text-success" : "text-danger")">
                                                    @venda.LucroTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="@(venda.MargemPercentual >= 0 ? "text-success" : "text-danger")">
                                                    @venda.MargemPercentual.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>
                                                @if (venda.VendaAbaixoDoCusto)
                                                {
                                                    <span class="badge bg-danger">Abaixo do Custo</span>
                                                }
                                                else if (venda.MargemPercentual > 30)
                                                {
                                                    <span class="badge bg-success">Alta Margem</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">Normal</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Vendas" asp-action="Detalhes" asp-route-id="@venda.Id" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="3">TOTAIS:</th>
                                        <th><strong>@Model.Sum(v => v.ValorTotal).ToString("C")</strong></th>
                                        <th><strong>@Model.Sum(v => v.CustoTotal).ToString("C")</strong></th>
                                        <th><strong class="@(Model.Sum(v => v.LucroTotal) >= 0 ? "text-success" : "text-danger")">@Model.Sum(v => v.LucroTotal).ToString("C")</strong></th>
                                        <th><strong>@(Model.Sum(v => v.ValorTotal) > 0 ? ((Model.Sum(v => v.LucroTotal) / Model.Sum(v => v.ValorTotal)) * 100).ToString("N1") : "0,0")%</strong></th>
                                        <th colspan="2">-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhuma venda com margem calculada encontrada no período selecionado.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-controller="Vendas" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar às Vendas
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-success { background-color: rgba(25, 135, 84, 0.1) !important; }
    .table-danger { background-color: rgba(220, 53, 69, 0.1) !important; }
</style>