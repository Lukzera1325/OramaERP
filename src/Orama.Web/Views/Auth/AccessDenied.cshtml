@{
    ViewData["Title"] = "Acesso Negado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i>
                        Acesso Negado
                    </h4>
                </div>
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fas fa-ban text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h5>Você não tem permissão para acessar esta página</h5>
                    <p class="text-muted">
                        Entre em contato com o administrador do sistema para solicitar as permissões necessárias.
                    </p>
                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="fas fa-home"></i>
                            Voltar ao Dashboard
                        </a>
                        <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-secondary ms-2">
                            <i class="fas fa-sign-out-alt"></i>
                            Sair do Sistema
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>