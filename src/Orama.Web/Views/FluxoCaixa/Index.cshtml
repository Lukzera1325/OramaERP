@model FluxoCaixaViewModel

@{
    ViewData["Title"] = "Fluxo de Caixa";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-chart-line me-2"></i>Fluxo de Caixa
                    </h3>
                    <div class="btn-group">
                        <button type="button" class="btn btn-success" onclick="exportarExcel()">
                            <i class="fas fa-file-excel me-1"></i>Exportar
                        </button>
                    </div>
                </div>

                <!-- Filtros -->
                <div class="card-body border-bottom">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Data Início</label>
                            <input type="date" name="dataInicio" class="form-control" value="@Model.DataInicio.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Data Fim</label>
                            <input type="date" name="dataFim" class="form-control" value="@Model.DataFim.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search me-1"></i>Filtrar
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Resumo Financeiro -->
                <div class="card-body">
                    <div class="row">
                        <!-- Saldo Atual -->
                        <div class="col-md-3 mb-4">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="card-title">Saldo Atual</h6>
                                            <h3 class="mb-0">@Model.SaldoAtual.ToString("C")</h3>
                                        </div>
                                        <i class="fas fa-wallet fa-2x opacity-75"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total a Receber -->
                        <div class="col-md-3 mb-4">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="card-title">A Receber</h6>
                                            <h3 class="mb-0">@Model.TotalAReceber.ToString("C")</h3>
                                        </div>
                                        <i class="fas fa-arrow-up fa-2x opacity-75"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Total a Pagar -->
                        <div class="col-md-3 mb-4">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="card-title">A Pagar</h6>
                                            <h3 class="mb-0">@Model.TotalAPagar.ToString("C")</h3>
                                        </div>
                                        <i class="fas fa-arrow-down fa-2x opacity-75"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Saldo Projetado -->
                        <div class="col-md-3 mb-4">
                            <div class="card @(Model.SaldoProjetado >= 0 ? "bg-info" : "bg-warning") text-white">
                                <div class="card-body text-center">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="card-title">Projetado</h6>
                                            <h3 class="mb-0">@Model.SaldoProjetado.ToString("C")</h3>
                                        </div>
                                        <i class="fas fa-chart-line fa-2x opacity-75"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico de Fluxo -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-chart-area me-2"></i>Evolução do Saldo
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <canvas id="fluxoChart" height="100"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Movimentações -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-list me-2"></i>Movimentações do Período
                                    </h5>
                                </div>
                                <div class="card-body">
                                    @if (Model.Movimentacoes.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-striped table-hover">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th>Data</th>
                                                        <th>Descrição</th>
                                                        <th>Tipo</th>
                                                        <th>Valor</th>
                                                        <th>Conta</th>
                                                        <th>Saldo Anterior</th>
                                                        <th>Saldo Posterior</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var mov in Model.Movimentacoes)
                                                    {
                                                        <tr>
                                                            <td>@mov.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                                            <td>@mov.Descricao</td>
                                                            <td>
                                                                <span class="badge @(mov.Tipo == "Entrada" ? "bg-success" : "bg-danger")">
                                                                    @mov.Tipo
                                                                </span>
                                                            </td>
                                                            <td class="@(mov.Tipo == "Entrada" ? "text-success" : "text-danger")">
                                                                @(mov.Tipo == "Entrada" ? "+" : "-")@mov.Valor.ToString("C")
                                                            </td>
                                                            <td>@mov.ContaBancaria</td>
                                                            <td>@mov.SaldoAnterior.ToString("C")</td>
                                                            <td>@mov.SaldoPosterior.ToString("C")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-5">
                                            <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                                            <h4>Nenhuma movimentação encontrada</h4>
                                            <p class="text-muted">Não há movimentações no período selecionado.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de Fluxo de Caixa
        const ctx = document.getElementById('fluxoChart').getContext('2d');
        
        // Dados simulados - em produção viriam do controller
        const labels = @Html.Raw(Json.Serialize(Model.Movimentacoes.Take(10).Select(m => m.Data.ToString("dd/MM")).ToArray()));
        const saldos = @Html.Raw(Json.Serialize(Model.Movimentacoes.Take(10).Select(m => m.SaldoPosterior).ToArray()));
        
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Saldo',
                    data: saldos,
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.1)',
                    tension: 0.1,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Evolução do Saldo - Últimas 10 Movimentações'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        ticks: {
                            callback: function(value) {
                                return new Intl.NumberFormat('pt-BR', {
                                    style: 'currency',
                                    currency: 'BRL'
                                }).format(value);
                            }
                        }
                    }
                }
            }
        });

        function exportarExcel() {
            const dataInicio = document.querySelector('input[name="dataInicio"]').value;
            const dataFim = document.querySelector('input[name="dataFim"]').value;
            
            $.post('@Url.Action("ExportarExcel")', {
                dataInicio: dataInicio,
                dataFim: dataFim
            })
            .done(function(response) {
                if (response.success) {
                    toastr.success('Dados exportados com sucesso!');
                    console.log('Dados:', response.dados);
                } else {
                    toastr.error('Erro ao exportar dados');
                }
            })
            .fail(function() {
                toastr.error('Erro ao exportar dados');
            });
        }
    </script>
}