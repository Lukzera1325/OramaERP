@model Orama.Domain.Entities.ExplicacaoResultado

@{
    ViewData["Title"] = "Detalhes da Explicação";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-lightbulb text-warning"></i>
                        Detalhes da Explicação #@Model.Id
                    </h3>
                    <div>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Voltar
                        </a>
                        <a href="@Url.Action("Venda", new { vendaId = Model.VendaId })" class="btn btn-info btn-sm">
                            <i class="fas fa-list"></i> Todas da Venda
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Tipo e Categoria -->
                        <div class="col-md-6">
                            <div class="card @Model.CssClass">
                                <div class="card-header">
                                    <h5>
                                        <i class="@Model.Icone"></i>
                                        Tipo de Resultado
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Tipo:</strong></td>
                                            <td>
                                                <span class="badge @(Model.Tipo == TipoResultado.Prejuizo ? "badge-danger" : Model.Tipo == TipoResultado.Atencao ? "badge-warning" : "badge-success")">
                                                    @Model.TipoDescricao
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Categoria:</strong></td>
                                            <td>@Model.CategoriaDescricao</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Data:</strong></td>
                                            <td>@Model.DataExplicacao.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Dados Financeiros -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-calculator"></i> Dados Financeiros</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Valor da Venda:</strong></td>
                                            <td class="text-right"><strong>@Model.ValorVenda.ToString("C")</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Custo Total:</strong></td>
                                            <td class="text-right">@Model.CustoTotal.ToString("C")</td>
                                        </tr>
                                        <tr class="@(Model.LucroCalculado < 0 ? "table-danger" : "table-success")">
                                            <td><strong>Resultado:</strong></td>
                                            <td class="text-right">
                                                <strong class="@(Model.LucroCalculado < 0 ? "text-danger" : "text-success")">
                                                    @Model.LucroCalculado.ToString("C")
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr class="@(Model.MargemPercentual < 0 ? "table-danger" : Model.MargemPercentual < 10 ? "table-warning" : "table-success")">
                                            <td><strong>Margem:</strong></td>
                                            <td class="text-right">
                                                <strong class="@(Model.MargemPercentual < 0 ? "text-danger" : Model.MargemPercentual < 10 ? "text-warning" : "text-success")">
                                                    @Model.MargemPercentual.ToString("N2")%
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Explicação Completa -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-comment-alt"></i> Explicação Detalhada</h5>
                                </div>
                                <div class="card-body">
                                    <div class="alert @Model.CssClass">
                                        <h6><strong>Resumo:</strong></h6>
                                        <p class="mb-2">@Model.ResumoExplicacao</p>
                                        
                                        <h6><strong>Explicação Completa:</strong></h6>
                                        <p class="mb-0">@Model.TextoExplicacao</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Informações da Venda -->
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-shopping-cart"></i> Dados da Venda</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Número:</strong></td>
                                            <td>@Model.Venda.Numero</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cliente:</strong></td>
                                            <td>@(Model.Venda.Cliente?.Nome ?? "N/A")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Data da Venda:</strong></td>
                                            <td>@Model.Venda.DataVenda.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>
                                                <span class="badge badge-info">@Model.Venda.Status</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Valor Total:</strong></td>
                                            <td><strong>@Model.Venda.ValorTotal.ToString("C")</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Margem Real:</strong></td>
                                            <td>
                                                <span class="badge @(Model.Venda.MargemPercentual < 0 ? "badge-danger" : Model.Venda.MargemPercentual < 10 ? "badge-warning" : "badge-success")">
                                                    @Model.Venda.MargemPercentual.ToString("N1")%
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                    <a href="/Vendas/Detalhes/@Model.VendaId" class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i> Ver Venda Completa
                                    </a>
                                </div>
                            </div>
                        </div>

                        @if (Model.Produto != null)
                        {
                            <!-- Informações do Produto (se aplicável) -->
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-box"></i> Produto Relacionado</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-borderless">
                                            <tr>
                                                <td><strong>Código:</strong></td>
                                                <td>@Model.Produto.Codigo</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Descrição:</strong></td>
                                                <td>@Model.Produto.Descricao</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Custo Atual:</strong></td>
                                                <td>@Model.Produto.PrecoCusto.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Preço de Venda:</strong></td>
                                                <td>@Model.Produto.PrecoVenda.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Margem Padrão:</strong></td>
                                                <td>
                                                    <span class="badge @(Model.Produto.MargemLucro < 10 ? "badge-warning" : "badge-success")">
                                                        @Model.Produto.MargemLucro.ToString("N1")%
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                        <a href="/Produtos/Detalhes/@Model.ProdutoId" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Ver Produto
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Análise Geral da Venda -->
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-chart-line"></i> Análise da Venda</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-borderless">
                                            <tr>
                                                <td><strong>Itens na Venda:</strong></td>
                                                <td>@Model.Venda.Itens.Count</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Subtotal:</strong></td>
                                                <td>@Model.Venda.SubTotal.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Desconto:</strong></td>
                                                <td>@Model.Venda.ValorDesconto.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Frete:</strong></td>
                                                <td>@Model.Venda.ValorFrete.ToString("C")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Custo Total:</strong></td>
                                                <td>@Model.Venda.CustoTotal.ToString("C")</td>
                                            </tr>
                                            <tr class="@(Model.Venda.LucroTotal < 0 ? "table-danger" : "table-success")">
                                                <td><strong>Lucro Total:</strong></td>
                                                <td>
                                                    <strong class="@(Model.Venda.LucroTotal < 0 ? "text-danger" : "text-success")">
                                                        @Model.Venda.LucroTotal.ToString("C")
                                                    </strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Ações Relacionadas -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-tools"></i> Ações Relacionadas</h5>
                                </div>
                                <div class="card-body">
                                    <div class="btn-group" role="group">
                                        <a href="/Vendas/Detalhes/@Model.VendaId" class="btn btn-info">
                                            <i class="fas fa-shopping-cart"></i> Ver Venda
                                        </a>
                                        <a href="/Alertas/Index" class="btn btn-warning">
                                            <i class="fas fa-exclamation-triangle"></i> Ver Alertas
                                        </a>
                                        <a href="@Url.Action("Index", new { tipo = Model.Tipo })" class="btn btn-secondary">
                                            <i class="fas fa-list"></i> Explicações Similares
                                        </a>
                                        @if (Model.Produto != null)
                                        {
                                            <a href="/Produtos/Detalhes/@Model.ProdutoId" class="btn btn-primary">
                                                <i class="fas fa-box"></i> Ver Produto
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>