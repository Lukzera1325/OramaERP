@model List<ContaPagarViewModel>

@{
    ViewData["Title"] = "Aprovação de Contas a Pagar";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-check-circle me-2"></i>Aprovação de Contas a Pagar
                    </h3>
                    <div class="btn-group">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Voltar
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Descrição</th>
                                        <th>Fornecedor</th>
                                        <th>Vencimento</th>
                                        <th>Valor</th>
                                        <th>Status</th>
                                        <th width="200">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var conta in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@conta.Descricao</strong>
                                                @if (!string.IsNullOrEmpty(conta.NumeroDocumento))
                                                {
                                                    <br><small class="text-muted">Doc: @conta.NumeroDocumento</small>
                                                }
                                            </td>
                                            <td>@conta.FornecedorNome</td>
                                            <td>
                                                @conta.DataVencimento.ToString("dd/MM/yyyy")
                                                @if (conta.Vencida)
                                                {
                                                    <br><span class="badge bg-danger">Vencida</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@conta.ValorTotal.ToString("C")</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning">Pendente Aprovação</span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-success" onclick="aprovarConta(@conta.Id)">
                                                        <i class="fas fa-check"></i> Aprovar
                                                    </button>
                                                    <button type="button" class="btn btn-danger" onclick="reprovarConta(@conta.Id)">
                                                        <i class="fas fa-times"></i> Reprovar
                                                    </button>
                                                    <a asp-action="Details" asp-route-id="@conta.Id" class="btn btn-info">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h4>Nenhuma conta pendente de aprovação</h4>
                            <p class="text-muted">Todas as contas foram aprovadas ou não há contas cadastradas.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Reprovação -->
<div class="modal fade" id="modalReprovar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reprovar Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Motivo da Reprovação</label>
                    <textarea id="motivoReprovacao" class="form-control" rows="3" placeholder="Informe o motivo da reprovação..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarReprovacao()">Reprovar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let contaIdParaReprovar = 0;

        function aprovarConta(id) {
            if (confirm('Deseja aprovar esta conta?')) {
                $.post('@Url.Action("Aprovar")', { id: id })
                    .done(function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    })
                    .fail(function() {
                        toastr.error('Erro ao aprovar conta');
                    });
            }
        }

        function reprovarConta(id) {
            contaIdParaReprovar = id;
            $('#motivoReprovacao').val('');
            $('#modalReprovar').modal('show');
        }

        function confirmarReprovacao() {
            const motivo = $('#motivoReprovacao').val().trim();
            if (!motivo) {
                toastr.error('Informe o motivo da reprovação');
                return;
            }

            $.post('@Url.Action("Reprovar")', { 
                id: contaIdParaReprovar, 
                motivo: motivo 
            })
            .done(function(response) {
                if (response.success) {
                    toastr.success(response.message);
                    $('#modalReprovar').modal('hide');
                    location.reload();
                } else {
                    toastr.error(response.message);
                }
            })
            .fail(function() {
                toastr.error('Erro ao reprovar conta');
            });
        }
    </script>
}