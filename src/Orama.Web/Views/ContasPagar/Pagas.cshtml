@model IEnumerable<ContaPagarViewModel>
@{
    ViewData["Title"] = "Contas Pagas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-check-circle text-success me-2"></i>Contas Pagas
                    </h3>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-clock"></i> Contas a Pagar
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Resumo -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Total Pago</h6>
                                            <h4 class="mb-0">@ViewBag.TotalPago?.ToString("C")</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-money-bill-wave fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Quantidade</h6>
                                            <h4 class="mb-0">@Model.Count()</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-list fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-secondary text-white">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6 class="card-title">Ticket Médio</h6>
                                            <h4 class="mb-0">@((Model.Any() ? Model.Average(c => c.ValorTotal) : 0).ToString("C"))</h4>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fas fa-chart-line fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Descrição</th>
                                        <th>Fornecedor</th>
                                        <th>Vencimento</th>
                                        <th>Data Pagamento</th>
                                        <th>Valor Original</th>
                                        <th>Valor Pago</th>
                                        <th>Forma Pagamento</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var conta in Model.OrderByDescending(c => c.DataPagamento))
                                    {
                                        <tr>
                                            <td>
                                                <strong>@conta.Descricao</strong>
                                                @if (!string.IsNullOrEmpty(conta.Observacoes))
                                                {
                                                    <br><small class="text-muted">@conta.Observacoes</small>
                                                }
                                            </td>
                                            <td>@conta.FornecedorNome</td>
                                            <td>
                                                <span class="badge bg-secondary">
                                                    @conta.DataVencimento.ToString("dd/MM/yyyy")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">
                                                    @conta.DataPagamento?.ToString("dd/MM/yyyy")
                                                </span>
                                            </td>
                                            <td>
                                                <strong class="text-primary">@conta.ValorOriginal.ToString("C")</strong>
                                            </td>
                                            <td>
                                                <strong class="text-danger">@conta.ValorTotal.ToString("C")</strong>
                                                @if (conta.ValorTotal != conta.ValorOriginal)
                                                {
                                                    var diferenca = conta.ValorTotal - conta.ValorOriginal;
                                                    <br><small class="@(diferenca > 0 ? "text-danger" : "text-success")">
                                                        (@(diferenca > 0 ? "+" : "")@diferenca.ToString("C"))
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@conta.FormaPagamento.ToString()</span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@conta.Id" 
                                                       class="btn btn-sm btn-outline-info" title="Detalhes">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma conta paga encontrada</h5>
                            <p class="text-muted">As contas pagas aparecerão aqui após o pagamento.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Inicializar DataTable se houver dados
            @if (Model.Any())
            {
                <text>
                $('table').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Portuguese-Brasil.json"
                    },
                    "order": [[ 3, "desc" ]], // Ordenar por data de pagamento
                    "pageLength": 25
                });
                </text>
            }
        });
    </script>
}