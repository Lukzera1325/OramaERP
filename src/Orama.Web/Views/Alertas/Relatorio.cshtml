@model IEnumerable<Orama.Domain.Entities.AlertaMargem>

@{
    ViewData["Title"] = "Relatório de Alertas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-chart-bar"></i>
                        Relatório de Alertas de Margem
                    </h3>
                    <div>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Voltar
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="mb-4">
                        <div class="row">
                            <div class="col-md-3">
                                <label>Data Início:</label>
                                <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio">
                            </div>
                            <div class="col-md-3">
                                <label>Data Fim:</label>
                                <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim">
                            </div>
                            <div class="col-md-3">
                                <label>Status:</label>
                                <select name="status" class="form-control">
                                    <option value="">Todos</option>
                                    <option value="@((int)StatusAlerta.Ativo)" selected="@(ViewBag.Status?.ToString() == StatusAlerta.Ativo.ToString())">Ativo</option>
                                    <option value="@((int)StatusAlerta.Resolvido)" selected="@(ViewBag.Status?.ToString() == StatusAlerta.Resolvido.ToString())">Resolvido</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Filtrar
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhum alerta encontrado para o período selecionado.
                        </div>
                    }
                    else
                    {
                        <!-- Estatísticas do Período -->
                        <div class="row mb-4">
                            <div class="col-md-2">
                                <div class="info-box bg-info">
                                    <span class="info-box-icon"><i class="fas fa-list"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total</span>
                                        <span class="info-box-number">@Model.Count()</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="info-box bg-warning">
                                    <span class="info-box-icon"><i class="fas fa-exclamation-triangle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Ativos</span>
                                        <span class="info-box-number">@Model.Count(a => a.Status == StatusAlerta.Ativo)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="info-box bg-success">
                                    <span class="info-box-icon"><i class="fas fa-check"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Resolvidos</span>
                                        <span class="info-box-number">@Model.Count(a => a.Status == StatusAlerta.Resolvido)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box bg-danger">
                                    <span class="info-box-icon"><i class="fas fa-arrow-down"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Vendas c/ Prejuízo</span>
                                        <span class="info-box-number">@Model.Count(a => a.Tipo == TipoAlertaMargem.VendaMargemNegativa)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box bg-red">
                                    <span class="info-box-icon"><i class="fas fa-dollar-sign"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Prejuízo Total</span>
                                        <span class="info-box-number">@Model.Where(a => a.LucroVenda < 0).Sum(a => Math.Abs(a.LucroVenda)).ToString("C")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela de Alertas -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Status</th>
                                        <th>Tipo</th>
                                        <th>Venda</th>
                                        <th>Cliente</th>
                                        <th>Produto</th>
                                        <th>Valor Venda</th>
                                        <th>Custo</th>
                                        <th>Prejuízo</th>
                                        <th>Margem %</th>
                                        <th>Data Alerta</th>
                                        <th>Data Resolução</th>
                                        <th>Resolvido por</th>
                                        <th width="80">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alerta in Model.OrderByDescending(a => a.DataAlerta))
                                    {
                                        <tr class="@(alerta.Status == StatusAlerta.Ativo ? (alerta.Tipo == TipoAlertaMargem.VendaMargemNegativa ? "table-danger" : "table-warning") : "")">
                                            <td>
                                                @if (alerta.EhAtivo)
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-exclamation-circle"></i> Ativo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-check-circle"></i> Resolvido
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (alerta.Tipo == TipoAlertaMargem.VendaMargemNegativa)
                                                {
                                                    <span class="badge badge-danger">
                                                        <i class="fas fa-exclamation-triangle"></i> Venda c/ Prejuízo
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-box"></i> Produto Abaixo Custo
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@alerta.Venda.Numero</strong><br>
                                                <small class="text-muted">@alerta.Venda.DataVenda.ToString("dd/MM/yyyy")</small>
                                            </td>
                                            <td>
                                                @alerta.Venda.Cliente?.Nome
                                            </td>
                                            <td>
                                                @if (alerta.Produto != null)
                                                {
                                                    <strong>@alerta.Produto.Codigo</strong><br>
                                                    <small>@alerta.Produto.Descricao</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-right">
                                                <strong>@alerta.ValorVenda.ToString("C")</strong>
                                            </td>
                                            <td class="text-right">
                                                @alerta.CustoTotal.ToString("C")
                                            </td>
                                            <td class="text-right">
                                                <span class="text-danger">
                                                    <strong>@alerta.LucroVenda.ToString("C")</strong>
                                                </span>
                                            </td>
                                            <td class="text-right">
                                                <span class="@(alerta.MargemPercentual < 0 ? "text-danger" : "text-warning")">
                                                    <strong>@alerta.MargemPercentual.ToString("N1")%</strong>
                                                </span>
                                            </td>
                                            <td>
                                                @alerta.DataAlerta.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                @if (alerta.DataResolucao.HasValue)
                                                {
                                                    @alerta.DataResolucao.Value.ToString("dd/MM/yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @(alerta.UsuarioResolucao?.Nome ?? "-")
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Detalhes", new { id = alerta.Id })" 
                                                   class="btn btn-info btn-sm" title="Ver Detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Resumo por Tipo -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Alertas por Tipo</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm">
                                            <tr>
                                                <td>Vendas com Prejuízo:</td>
                                                <td class="text-right">
                                                    <strong>@Model.Count(a => a.Tipo == TipoAlertaMargem.VendaMargemNegativa)</strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Produtos Abaixo do Custo:</td>
                                                <td class="text-right">
                                                    <strong>@Model.Count(a => a.Tipo == TipoAlertaMargem.ProdutoAbaixoCusto)</strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Impacto Financeiro</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm">
                                            <tr>
                                                <td>Prejuízo Total Detectado:</td>
                                                <td class="text-right">
                                                    <strong class="text-danger">
                                                        @Model.Where(a => a.LucroVenda < 0).Sum(a => Math.Abs(a.LucroVenda)).ToString("C")
                                                    </strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Valor Total das Vendas:</td>
                                                <td class="text-right">
                                                    <strong>@Model.Sum(a => a.ValorVenda).ToString("C")</strong>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Custo Total:</td>
                                                <td class="text-right">
                                                    <strong>@Model.Sum(a => a.CustoTotal).ToString("C")</strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>