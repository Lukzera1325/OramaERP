@model IEnumerable<Orama.Domain.Entities.AlertaMargem>

@{
    ViewData["Title"] = "Alertas de Margem";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-exclamation-triangle text-warning"></i>
                        Alertas de Margem Ativo
                    </h3>
                    <div>
                        <a href="@Url.Action("Relatorio")" class="btn btn-info btn-sm">
                            <i class="fas fa-chart-bar"></i> Relatório
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i>
                            <strong>Parabéns!</strong> Não há alertas de margem ativos no momento.
                        </div>
                    }
                    else
                    {
                        <!-- Resumo Executivo -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="info-box bg-warning">
                                    <span class="info-box-icon"><i class="fas fa-exclamation-triangle"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Total de Alertas</span>
                                        <span class="info-box-number">@Model.Count()</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box bg-danger">
                                    <span class="info-box-icon"><i class="fas fa-arrow-down"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Vendas c/ Prejuízo</span>
                                        <span class="info-box-number">@Model.Count(a => a.Tipo == TipoAlertaMargem.VendaMargemNegativa)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box bg-orange">
                                    <span class="info-box-icon"><i class="fas fa-box"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Produtos Abaixo Custo</span>
                                        <span class="info-box-number">@Model.Count(a => a.Tipo == TipoAlertaMargem.ProdutoAbaixoCusto)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-box bg-red">
                                    <span class="info-box-icon"><i class="fas fa-dollar-sign"></i></span>
                                    <div class="info-box-content">
                                        <span class="info-box-text">Prejuízo Total</span>
                                        <span class="info-box-number">@Model.Where(a => a.LucroVenda < 0).Sum(a => Math.Abs(a.LucroVenda)).ToString("C")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ações em Lote -->
                        <form id="formLote" method="post" action="@Url.Action("ResolverLote")">
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <input type="text" name="observacoes" class="form-control" placeholder="Observações para resolução em lote (opcional)">
                                </div>
                                <div class="col-md-4">
                                    <button type="submit" class="btn btn-success" onclick="return confirmarResolucaoLote()">
                                        <i class="fas fa-check"></i> Resolver Selecionados
                                    </button>
                                </div>
                            </div>

                            <!-- Tabela de Alertas -->
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th width="30">
                                                <input type="checkbox" id="selecionarTodos" onchange="selecionarTodosAlertas()">
                                            </th>
                                            <th>Tipo</th>
                                            <th>Venda</th>
                                            <th>Cliente</th>
                                            <th>Produto</th>
                                            <th>Valor Venda</th>
                                            <th>Custo</th>
                                            <th>Prejuízo</th>
                                            <th>Margem %</th>
                                            <th>Data</th>
                                            <th>Dias</th>
                                            <th width="120">Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var alerta in Model.OrderByDescending(a => a.DataAlerta))
                                        {
                                            <tr class="@(alerta.Tipo == TipoAlertaMargem.VendaMargemNegativa ? "table-danger" : "table-warning")">
                                                <td>
                                                    <input type="checkbox" name="alertaIds" value="@alerta.Id" class="checkbox-alerta">
                                                </td>
                                                <td>
                                                    @if (alerta.Tipo == TipoAlertaMargem.VendaMargemNegativa)
                                                    {
                                                        <span class="badge badge-danger">
                                                            <i class="fas fa-exclamation-triangle"></i> Venda c/ Prejuízo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">
                                                            <i class="fas fa-box"></i> Produto Abaixo Custo
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <strong>@alerta.Venda.Numero</strong><br>
                                                    <small class="text-muted">@alerta.Venda.DataVenda.ToString("dd/MM/yyyy")</small>
                                                </td>
                                                <td>
                                                    @alerta.Venda.Cliente?.Nome
                                                </td>
                                                <td>
                                                    @if (alerta.Produto != null)
                                                    {
                                                        <strong>@alerta.Produto.Codigo</strong><br>
                                                        <small>@alerta.Produto.Descricao</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    <strong>@alerta.ValorVenda.ToString("C")</strong>
                                                </td>
                                                <td class="text-right">
                                                    @alerta.CustoTotal.ToString("C")
                                                </td>
                                                <td class="text-right">
                                                    <span class="text-danger">
                                                        <strong>@alerta.LucroVenda.ToString("C")</strong>
                                                    </span>
                                                </td>
                                                <td class="text-right">
                                                    <span class="@(alerta.MargemPercentual < 0 ? "text-danger" : "text-warning")">
                                                        <strong>@alerta.MargemPercentual.ToString("N1")%</strong>
                                                    </span>
                                                </td>
                                                <td>
                                                    @alerta.DataAlerta.ToString("dd/MM/yyyy HH:mm")
                                                </td>
                                                <td>
                                                    <span class="badge @(alerta.DiasDesdeAlerta > 7 ? "badge-danger" : alerta.DiasDesdeAlerta > 3 ? "badge-warning" : "badge-info")">
                                                        @alerta.DiasDesdeAlerta dia(s)
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <a href="@Url.Action("Detalhes", new { id = alerta.Id })" 
                                                           class="btn btn-info btn-sm" title="Ver Detalhes">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-success btn-sm" 
                                                                onclick="resolverAlerta(@alerta.Id)" title="Resolver">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Resolver Alerta Individual -->
<div class="modal fade" id="modalResolverAlerta" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Resolver Alerta</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form id="formResolverAlerta" method="post">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Observações (opcional):</label>
                        <textarea name="observacoes" class="form-control" rows="3" 
                                  placeholder="Descreva como o problema foi resolvido..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check"></i> Resolver Alerta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selecionarTodosAlertas() {
            const selecionarTodos = document.getElementById('selecionarTodos');
            const checkboxes = document.querySelectorAll('.checkbox-alerta');
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = selecionarTodos.checked;
            });
        }

        function confirmarResolucaoLote() {
            const selecionados = document.querySelectorAll('.checkbox-alerta:checked');
            
            if (selecionados.length === 0) {
                alert('Selecione pelo menos um alerta para resolver.');
                return false;
            }

            return confirm(`Tem certeza que deseja resolver ${selecionados.length} alerta(s) selecionado(s)?`);
        }

        function resolverAlerta(alertaId) {
            document.getElementById('formResolverAlerta').action = '@Url.Action("Resolver")/' + alertaId;
            $('#modalResolverAlerta').modal('show');
        }
    </script>
}