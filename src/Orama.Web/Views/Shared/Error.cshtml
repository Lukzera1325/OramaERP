@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-exclamation-triangle fa-5x text-santorini-coral"></i>
                    </div>
                    
                    <h1 class="display-4 mb-3">Oops! Algo deu errado</h1>
                    <p class="lead mb-4">
                        Ocorreu um erro inesperado. Nossa equipe foi notificada e está trabalhando para resolver o problema.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-secondary">
                            <strong>ID da Requisição:</strong> @Model.RequestId
                            <br>
                            <small class="text-muted">
                                Informe este código ao entrar em contato com o suporte técnico.
                            </small>
                        </div>
                    }

                    <div class="mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-3">
                            <i class="fas fa-home me-2"></i>
                            Voltar ao Dashboard
                        </a>
                        <button onclick="history.back()" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Página Anterior
                        </button>
                    </div>

                    <div class="mt-5">
                        <h5>Precisa de ajuda?</h5>
                        <p class="text-muted">
                            Entre em contato com nosso suporte técnico:
                        </p>
                        <div class="row justify-content-center">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-envelope text-santorini-blue me-3"></i>
                                    <span>suporte@orama.com.br</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-phone text-santorini-blue me-3"></i>
                                    <span>(11) 1234-5678</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>