<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Orama ERP</title>
    <link rel="icon" type="image/png" href="~/images/icone.png" />
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/images/icone.png" alt="Orama" class="navbar-logo me-2" />
                <span class="brand-text">Orama</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle user-dropdown" href="#" role="button" data-bs-toggle="dropdown">
                            <div class="user-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <span class="d-none d-md-inline ms-2">@(ViewBag.UsuarioLogado?.Nome ?? "Usuário")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="dropdown-header">
                                <strong>@(ViewBag.UsuarioLogado?.Nome)</strong><br>
                                <small class="text-muted">@(ViewBag.UsuarioLogado?.Email)</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog me-2"></i>Meu Perfil</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Configurações</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Sair
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="wrapper">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <ul class="sidebar-nav">
                    <!-- Dashboard -->
                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    
                    <!-- Cadastros -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#cadastrosMenu" data-bs-toggle="collapse">
                            <i class="fas fa-folder-open"></i>
                            <span>Cadastros</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="cadastrosMenu">
                            <li><a href="@Url.Action("Index", "Clientes")"><i class="fas fa-users"></i>Clientes</a></li>
                            <li><a href="@Url.Action("Index", "Fornecedores")"><i class="fas fa-truck"></i>Fornecedores</a></li>
                            <li><a href="@Url.Action("Index", "Produtos")"><i class="fas fa-boxes"></i>Produtos</a></li>
                            <li><a href="@Url.Action("Index", "Categorias")"><i class="fas fa-tags"></i>Categorias</a></li>
                        </ul>
                    </li>
                    
                    <!-- Financeiro -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#financeiroMenu" data-bs-toggle="collapse">
                            <i class="fas fa-wallet"></i>
                            <span>Financeiro</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="financeiroMenu">
                            <li><a href="@Url.Action("Index", "ContasBancarias")"><i class="fas fa-university"></i>Contas Bancárias</a></li>
                            <li><a href="@Url.Action("Index", "ContasReceber")"><i class="fas fa-clock text-warning"></i>Contas a Receber</a></li>
                            <li><a href="@Url.Action("Recebidas", "ContasReceber")"><i class="fas fa-check-circle text-success"></i>Contas Recebidas</a></li>
                            <li><a href="@Url.Action("Index", "ContasPagar")"><i class="fas fa-clock text-warning"></i>Contas a Pagar</a></li>
                            <li><a href="@Url.Action("Pagas", "ContasPagar")"><i class="fas fa-check-circle text-danger"></i>Contas Pagas</a></li>
                            <li><a href="@Url.Action("Aprovacao", "ContasPagar")"><i class="fas fa-user-check text-info"></i>Aprovação de Contas</a></li>
                            <li><a href="@Url.Action("Agendados", "ContasPagar")"><i class="fas fa-calendar-alt text-primary"></i>Pagamentos Agendados</a></li>
                            <li><a href="@Url.Action("Index", "FluxoCaixa")"><i class="fas fa-chart-line"></i>Fluxo de Caixa</a></li>
                        </ul>
                    </li>
                    
                    <!-- Vendas -->
                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Vendas")">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Vendas</span>
                        </a>
                    </li>
                    
                    <!-- Compras -->
                    <li class="sidebar-item">
                        <a class="sidebar-link" href="@Url.Action("Index", "Compras")">
                            <i class="fas fa-shopping-bag"></i>
                            <span>Compras</span>
                        </a>
                    </li>
                    
                    <!-- Produção -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#producaoMenu" data-bs-toggle="collapse">
                            <i class="fas fa-cogs"></i>
                            <span>Produção</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="producaoMenu">
                            <li><a href="@Url.Action("Index", "Producao")"><i class="fas fa-tachometer-alt"></i>Dashboard</a></li>
                            <li><a href="@Url.Action("OrdensProducao", "Producao")"><i class="fas fa-cog"></i>Ordens de Produção</a></li>
                            <li><a href="@Url.Action("ListasMateriais", "Producao")"><i class="fas fa-list-check"></i>Lista de Materiais</a></li>
                            <li><a href="@Url.Action("ExplosaoMateriais", "Producao")"><i class="fas fa-sitemap"></i>Explosão de Materiais</a></li>
                            <li><a href="#"><i class="fas fa-clock"></i>Apontamento de Horas</a></li>
                            <li><a href="#"><i class="fas fa-shield-alt"></i>Controle de Qualidade</a></li>
                        </ul>
                    </li>
                    
                    <!-- Estoque -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#estoqueMenu" data-bs-toggle="collapse">
                            <i class="fas fa-warehouse"></i>
                            <span>Estoque</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="estoqueMenu">
                            <li><a href="@Url.Action("Posicao", "Estoque")"><i class="fas fa-boxes"></i>Posição de Estoque</a></li>
                            <li><a href="@Url.Action("Index", "Estoque")"><i class="fas fa-exchange-alt"></i>Movimentações</a></li>
                            <li><a href="@Url.Action("EstoqueBaixo", "Estoque")"><i class="fas fa-exclamation-triangle"></i>Estoque Baixo</a></li>
                            <li><a href="@Url.Action("Ajustar", "Estoque")"><i class="fas fa-edit"></i>Ajustar Estoque</a></li>
                            <li><a href="@Url.Action("Inventario", "Estoque")"><i class="fas fa-clipboard-list"></i>Inventário</a></li>
                        </ul>
                    </li>
                    
                    <!-- Relatórios -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#relatoriosMenu" data-bs-toggle="collapse">
                            <i class="fas fa-chart-bar"></i>
                            <span>Relatórios</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="relatoriosMenu">
                            <li><a href="@Url.Action("Index", "Relatorios")"><i class="fas fa-tachometer-alt"></i>Dashboard</a></li>
                            <li><a href="@Url.Action("Vendas", "Relatorios")"><i class="fas fa-chart-line"></i>Vendas</a></li>
                            <li><a href="@Url.Action("Compras", "Relatorios")"><i class="fas fa-chart-area"></i>Compras</a></li>
                            <li><a href="@Url.Action("Financeiro", "Relatorios")"><i class="fas fa-dollar-sign"></i>Financeiro</a></li>
                            <li><a href="@Url.Action("Estoque", "Relatorios")"><i class="fas fa-warehouse"></i>Estoque</a></li>
                            <li><a href="@Url.Action("DRE", "Relatorios")"><i class="fas fa-calculator"></i>DRE</a></li>
                        </ul>
                    </li>
                    
                    <!-- Fiscal -->
                    <li class="sidebar-item">
                        <a class="sidebar-link" href="#">
                            <i class="fas fa-file-invoice"></i>
                            <span>Fiscal</span>
                        </a>
                    </li>
                    
                    <!-- Segurança -->
                    <li class="sidebar-item has-submenu">
                        <a class="sidebar-link" href="#segurancaMenu" data-bs-toggle="collapse">
                            <i class="fas fa-shield-alt"></i>
                            <span>Segurança</span>
                            <i class="fas fa-chevron-down submenu-icon"></i>
                        </a>
                        <ul class="sidebar-submenu collapse" id="segurancaMenu">
                            <li><a href="@Url.Action("Index", "Usuarios")"><i class="fas fa-users-cog"></i>Usuários</a></li>
                            <li><a href="@Url.Action("Index", "Perfis")"><i class="fas fa-user-tag"></i>Perfis</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-wrapper">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/validacoes-avancadas.js" asp-append-version="true"></script>
    <script src="~/js/orama-utils.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
