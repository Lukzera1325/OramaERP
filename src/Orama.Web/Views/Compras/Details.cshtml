@model CompraViewModel
@{
    ViewData["Title"] = $"Compra {Model.NumeroCompra}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>Compra @Model.NumeroCompra
                    </h3>
                    <div class="btn-group">
                        @if (Model.PodeEditar)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Editar
                            </a>
                        }
                        @if (Model.PodeAprovar)
                        {
                            <button type="button" class="btn btn-info" onclick="aprovarCompra(@Model.Id)">
                                <i class="fas fa-check me-1"></i>Aprovar
                            </button>
                        }
                        @if (Model.PodeReceber)
                        {
                            <button type="button" class="btn btn-success" onclick="receberCompra(@Model.Id)">
                                <i class="fas fa-truck me-1"></i>Receber
                            </button>
                        }
                        @if (Model.PodeCancelar)
                        {
                            <button type="button" class="btn btn-danger" onclick="cancelarCompra(@Model.Id)">
                                <i class="fas fa-times me-1"></i>Cancelar
                            </button>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Voltar
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Informações Gerais -->
                        <div class="col-md-6">
                            <h5 class="border-bottom pb-2 mb-3">Informações Gerais</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Número:</dt>
                                <dd class="col-sm-8">@Model.NumeroCompra</dd>

                                <dt class="col-sm-4">Fornecedor:</dt>
                                <dd class="col-sm-8">@Model.FornecedorNome</dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @Model.StatusBadgeClass">
                                        @Model.StatusDescricao
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Data Compra:</dt>
                                <dd class="col-sm-8">@Model.DataCompra.ToString("dd/MM/yyyy")</dd>

                                @if (Model.DataEntrega.HasValue)
                                {
                                    <dt class="col-sm-4">Data Entrega:</dt>
                                    <dd class="col-sm-8">@Model.DataEntrega.Value.ToString("dd/MM/yyyy")</dd>
                                }

                                @if (Model.DataRecebimento.HasValue)
                                {
                                    <dt class="col-sm-4">Data Recebimento:</dt>
                                    <dd class="col-sm-8">@Model.DataRecebimento.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                                }

                                @if (!string.IsNullOrEmpty(Model.NumeroNF))
                                {
                                    <dt class="col-sm-4">Número NF:</dt>
                                    <dd class="col-sm-8">
                                        <span class="badge bg-info">@Model.NumeroNF</span>
                                    </dd>
                                }
                            </dl>
                        </div>

                        <!-- Informações Financeiras -->
                        <div class="col-md-6">
                            <h5 class="border-bottom pb-2 mb-3">Informações Financeiras</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Subtotal:</dt>
                                <dd class="col-sm-8">@Model.SubTotal.ToString("C")</dd>

                                @if (Model.PercentualDesconto > 0)
                                {
                                    <dt class="col-sm-4">Desconto:</dt>
                                    <dd class="col-sm-8">
                                        @Model.PercentualDesconto.ToString("N2")% 
                                        (@Model.ValorDesconto.ToString("C"))
                                    </dd>
                                }

                                @if (Model.ValorFrete > 0)
                                {
                                    <dt class="col-sm-4">Frete:</dt>
                                    <dd class="col-sm-8">@Model.ValorFrete.ToString("C")</dd>
                                }

                                <dt class="col-sm-4">Forma Pagamento:</dt>
                                <dd class="col-sm-8">@Model.FormaPagamentoDescricao</dd>

                                <dt class="col-sm-4">Parcelas:</dt>
                                <dd class="col-sm-8">@Model.Parcelas</dd>

                                <dt class="col-sm-4"><strong>Total:</strong></dt>
                                <dd class="col-sm-8">
                                    <strong class="text-success fs-5">@Model.ValorTotal.ToString("C")</strong>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observacoes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">Observações</h5>
                                <p class="text-muted">@Model.Observacoes</p>
                            </div>
                        </div>
                    }

                    <!-- Itens da Compra -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Itens da Compra</h5>
                                @if (Model.PodeEditar)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" onclick="adicionarItem()">
                                        <i class="fas fa-plus me-1"></i>Adicionar Item
                                    </button>
                                }
                            </div>

                            <div id="itens-container">
                                @if (Model.Itens.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Código</th>
                                                    <th>Produto</th>
                                                    <th>Quantidade</th>
                                                    <th>Valor Unitário</th>
                                                    <th>Valor Total</th>
                                                    @if (Model.PodeEditar)
                                                    {
                                                        <th width="80">Ações</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Itens)
                                                {
                                                    <tr>
                                                        <td>@item.ProdutoCodigo</td>
                                                        <td>@item.ProdutoNome</td>
                                                        <td>@item.Quantidade.ToString("N2")</td>
                                                        <td>@item.ValorUnitario.ToString("C")</td>
                                                        <td>@item.ValorTotal.ToString("C")</td>
                                                        @if (Model.PodeEditar)
                                                        {
                                                            <td>
                                                                <div class="btn-group btn-group-sm">
                                                                    <button type="button" class="btn btn-outline-warning" 
                                                                            onclick="editarItem(@item.Id)" title="Editar">
                                                                        <i class="fas fa-edit"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-outline-danger" 
                                                                            onclick="removerItem(@item.Id)" title="Remover">
                                                                        <i class="fas fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-box-open fa-2x text-muted mb-2"></i>
                                        <p class="text-muted">Nenhum item adicionado</p>
                                        @if (Model.PodeEditar)
                                        {
                                            <button type="button" class="btn btn-primary" onclick="adicionarItem()">
                                                <i class="fas fa-plus me-1"></i>Adicionar Primeiro Item
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Adicionar/Editar Item -->
<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemModalTitle">Adicionar Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="itemForm">
                    <input type="hidden" id="itemId" value="0">
                    <div class="mb-3">
                        <label class="form-label">Produto *</label>
                        <select id="produtoId" class="form-select" required>
                            <option value="">Selecione um produto...</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Quantidade *</label>
                            <input type="number" id="quantidade" class="form-control" step="0.01" min="0.01" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Valor Unitário *</label>
                            <input type="number" id="valorUnitario" class="form-control" step="0.01" min="0.01" required>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Observações</label>
                        <textarea id="observacoes" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="salvarItem()">Salvar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/compras.js"></script>
    <script>
        const compraId = @Model.Id;
        const podeEditar = @Model.PodeEditar.ToString().ToLower();
    </script>
}