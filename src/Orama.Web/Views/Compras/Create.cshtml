@model CompraViewModel
@{
    ViewData["Title"] = "Nova Compra";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-plus me-2"></i>Nova Compra
                    </h3>
                </div>

                <form asp-action="Create" method="post">
                    <div class="card-body">
                        <div class="row">
                            <!-- Informações Gerais -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2 mb-3">Informações Gerais</h5>
                                
                                <div class="mb-3">
                                    <label asp-for="FornecedorId" class="form-label"></label>
                                    @Html.DropDownListFor(m => m.FornecedorId, Model.Fornecedores, "Selecione um fornecedor...", new { @class = "form-select", required = "required" })
                                    <span asp-validation-for="FornecedorId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NumeroNF" class="form-label"></label>
                                    <input asp-for="NumeroNF" class="form-control" placeholder="Número da nota fiscal">
                                    <span asp-validation-for="NumeroNF" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <label asp-for="DataCompra" class="form-label"></label>
                                        <input asp-for="DataCompra" class="form-control" type="date" required>
                                        <span asp-validation-for="DataCompra" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="DataEntrega" class="form-label"></label>
                                        <input asp-for="DataEntrega" class="form-control" type="date">
                                        <span asp-validation-for="DataEntrega" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Informações Financeiras -->
                            <div class="col-md-6">
                                <h5 class="border-bottom pb-2 mb-3">Informações Financeiras</h5>
                                
                                <div class="mb-3">
                                    <label asp-for="FormaPagamento" class="form-label"></label>
                                    @Html.DropDownListFor(m => m.FormaPagamento, Model.FormasPagamento, new { @class = "form-select" })
                                    <span asp-validation-for="FormaPagamento" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <label asp-for="Parcelas" class="form-label"></label>
                                        <input asp-for="Parcelas" class="form-control" type="number" min="1" max="60" required>
                                        <span asp-validation-for="Parcelas" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="PercentualDesconto" class="form-label"></label>
                                        <div class="input-group">
                                            <input asp-for="PercentualDesconto" class="form-control" type="number" step="0.01" min="0" max="100">
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <span asp-validation-for="PercentualDesconto" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ValorFrete" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        <input asp-for="ValorFrete" class="form-control" type="number" step="0.01" min="0">
                                    </div>
                                    <span asp-validation-for="ValorFrete" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <label asp-for="Observacoes" class="form-label"></label>
                                <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Observações sobre a compra..."></textarea>
                                <span asp-validation-for="Observacoes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Salvar Compra
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Máscara para valores monetários
            $('#ValorFrete').mask('#.##0,00', {reverse: true});
            
            // Auto-focus no primeiro campo
            $('#FornecedorId').focus();
            
            // Validação customizada
            $('form').on('submit', function(e) {
                var fornecedorId = $('#FornecedorId').val();
                if (!fornecedorId) {
                    e.preventDefault();
                    alert('Por favor, selecione um fornecedor.');
                    $('#FornecedorId').focus();
                    return false;
                }
            });
        });
    </script>
}