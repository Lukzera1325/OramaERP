@{
    ViewData["Title"] = "Relatórios Gerenciais";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <p class="lead">
                        Relatórios simples para análise de desempenho e tomada de decisão.
                    </p>

                    <div class="row">
                        <!-- Relatório 1: Produtos Mais Lucrativos -->
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-trophy"></i> Produtos Mais Lucrativos
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        Identifica quais produtos geram mais lucro para o negócio.
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-check text-success"></i> Receita por produto</li>
                                        <li><i class="fas fa-check text-success"></i> Custo por produto</li>
                                        <li><i class="fas fa-check text-success"></i> Margem média</li>
                                        <li><i class="fas fa-check text-success"></i> Ranking de lucratividade</li>
                                    </ul>
                                </div>
                                <div class="card-footer">
                                    <a asp-action="ProdutosMaisLucrativos" class="btn btn-success btn-block">
                                        <i class="fas fa-chart-bar"></i> Ver Relatório
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Relatório 2: Vendas com Margem Negativa -->
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 border-danger">
                                <div class="card-header bg-danger text-white">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-exclamation-triangle"></i> Vendas com Prejuízo
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        Detecta vendas realizadas abaixo do custo (margem negativa).
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-check text-success"></i> Vendas com prejuízo</li>
                                        <li><i class="fas fa-check text-success"></i> Produtos problemáticos</li>
                                        <li><i class="fas fa-check text-success"></i> Impacto financeiro</li>
                                        <li><i class="fas fa-check text-success"></i> Análise de causas</li>
                                    </ul>
                                </div>
                                <div class="card-footer">
                                    <a asp-action="VendasMargemNegativa" class="btn btn-danger btn-block">
                                        <i class="fas fa-search"></i> Ver Relatório
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Relatório 3: Evolução de Margem -->
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-chart-line"></i> Evolução de Margem
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">
                                        Acompanha a evolução da margem ao longo do tempo.
                                    </p>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-check text-success"></i> Tendência mensal</li>
                                        <li><i class="fas fa-check text-success"></i> Análise diária</li>
                                        <li><i class="fas fa-check text-success"></i> Comparativo de períodos</li>
                                        <li><i class="fas fa-check text-success"></i> Indicadores de performance</li>
                                    </ul>
                                </div>
                                <div class="card-footer">
                                    <a asp-action="EvolucaoMargem" class="btn btn-primary btn-block">
                                        <i class="fas fa-chart-area"></i> Ver Relatório
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Informações Importantes -->
                    <div class="alert alert-info">
                        <h5><i class="fas fa-info-circle"></i> Informações Importantes:</h5>
                        <ul class="mb-0">
                            <li>Os relatórios são baseados em vendas faturadas com margem calculada</li>
                            <li>Dados são atualizados automaticamente conforme novas vendas são processadas</li>
                            <li>Filtros por período permitem análises específicas</li>
                            <li>Todos os relatórios podem ser impressos ou exportados</li>
                        </ul>
                    </div>
                </div>
                <div class="card-footer">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-home"></i> Voltar ao Início
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>