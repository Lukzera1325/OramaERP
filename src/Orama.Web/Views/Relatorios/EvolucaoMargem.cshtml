@model IEnumerable<Orama.Application.Services.EvolucaoMargem>
@{
    ViewData["Title"] = "Evolução de Margem no Tempo";
    var resumo = ViewBag.Resumo;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="dataInicio" class="form-label">Data Início:</label>
                            <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
                        </div>
                        <div class="col-md-3">
                            <label for="dataFim" class="form-label">Data Fim:</label>
                            <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
                        </div>
                        <div class="col-md-3">
                            <label for="periodo" class="form-label">Período:</label>
                            <select name="periodo" class="form-control">
                                <option value="mensal" @(ViewBag.Periodo == "mensal" ? "selected" : "")>Mensal</option>
                                <option value="diario" @(ViewBag.Periodo == "diario" ? "selected" : "")>Diário</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </form>

                    <!-- Resumo do Período -->
                    <div class="row mb-4">
                        <div class="col-md-2">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>Total Vendas</h5>
                                    <h3>@resumo.TotalVendas</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h5>Receita Total</h5>
                                    <h3>@(((decimal)resumo.ReceitaTotal).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.LucroTotal >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Lucro Total</h5>
                                    <h3>@(((decimal)resumo.LucroTotal).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.MargemMedia >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Margem Média</h5>
                                    <h3>@(((decimal)resumo.MargemMedia).ToString("N1"))%</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h5>Melhor Margem</h5>
                                    <h3>@(((decimal)resumo.MelhorMargem).ToString("N1"))%</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-secondary text-white">
                                <div class="card-body text-center">
                                    <h5>Pior Margem</h5>
                                    <h3>@(((decimal)resumo.PiorMargem).ToString("N1"))%</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela de Evolução -->
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Período</th>
                                        <th>Qtd. Vendas</th>
                                        <th>Receita Total</th>
                                        <th>Custo Total</th>
                                        <th>Lucro Total</th>
                                        <th>Margem %</th>
                                        <th>Ticket Médio</th>
                                        <th>Tendência</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var periodos = Model.ToList();
                                        decimal? margemAnterior = null;
                                    }
                                    @for (int i = 0; i < periodos.Count; i++)
                                    {
                                        var periodo = periodos[i];
                                        string tendencia = "";
                                        string iconeTendencia = "";
                                        string corTendencia = "";

                                        if (margemAnterior.HasValue)
                                        {
                                            if (periodo.MargemCalculada > margemAnterior.Value)
                                            {
                                                tendencia = "Melhorando";
                                                iconeTendencia = "fas fa-arrow-up";
                                                corTendencia = "text-success";
                                            }
                                            else if (periodo.MargemCalculada < margemAnterior.Value)
                                            {
                                                tendencia = "Piorando";
                                                iconeTendencia = "fas fa-arrow-down";
                                                corTendencia = "text-danger";
                                            }
                                            else
                                            {
                                                tendencia = "Estável";
                                                iconeTendencia = "fas fa-minus";
                                                corTendencia = "text-warning";
                                            }
                                        }
                                        else
                                        {
                                            tendencia = "Primeiro";
                                            iconeTendencia = "fas fa-circle";
                                            corTendencia = "text-muted";
                                        }

                                        <tr class="@(periodo.PeriodoLucrativo ? "" : "table-danger")">
                                            <td><strong>@periodo.Periodo</strong></td>
                                            <td>@periodo.QuantidadeVendas</td>
                                            <td>@periodo.ReceitaTotal.ToString("C")</td>
                                            <td>@periodo.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="@(periodo.LucroTotal >= 0 ? "text-success" : "text-danger")">
                                                    @periodo.LucroTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="@(periodo.MargemCalculada >= 0 ? "text-success" : "text-danger")">
                                                    @periodo.MargemCalculada.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>@periodo.TicketMedio.ToString("C")</td>
                                            <td>
                                                <span class="@corTendencia">
                                                    <i class="@iconeTendencia"></i> @tendencia
                                                </span>
                                            </td>
                                            <td>
                                                @if (periodo.PeriodoLucrativo)
                                                {
                                                    if (periodo.MargemCalculada > 30)
                                                    {
                                                        <span class="badge bg-success">Excelente</span>
                                                    }
                                                    else if (periodo.MargemCalculada > 15)
                                                    {
                                                        <span class="badge bg-primary">Bom</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Regular</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Prejuízo</span>
                                                }
                                            </td>
                                        </tr>

                                        margemAnterior = periodo.MargemCalculada;
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th>TOTAIS:</th>
                                        <th>@Model.Sum(p => p.QuantidadeVendas)</th>
                                        <th><strong>@Model.Sum(p => p.ReceitaTotal).ToString("C")</strong></th>
                                        <th><strong>@Model.Sum(p => p.CustoTotal).ToString("C")</strong></th>
                                        <th><strong class="@(Model.Sum(p => p.LucroTotal) >= 0 ? "text-success" : "text-danger")">@Model.Sum(p => p.LucroTotal).ToString("C")</strong></th>
                                        <th><strong>@(Model.Sum(p => p.ReceitaTotal) > 0 ? ((Model.Sum(p => p.LucroTotal) / Model.Sum(p => p.ReceitaTotal)) * 100).ToString("N1") : "0,0")%</strong></th>
                                        <th>@(Model.Sum(p => p.QuantidadeVendas) > 0 ? (Model.Sum(p => p.ReceitaTotal) / Model.Sum(p => p.QuantidadeVendas)).ToString("C") : "R$ 0,00")</th>
                                        <th colspan="2">-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Análise de Tendência -->
                        @{
                            var periodosLucrativos = Model.Count(p => p.PeriodoLucrativo);
                            var totalPeriodos = Model.Count();
                            var margemInicial = Model.First().MargemCalculada;
                            var margemFinal = Model.Last().MargemCalculada;
                            var tendenciaGeral = margemFinal > margemInicial ? "Melhorando" : margemFinal < margemInicial ? "Piorando" : "Estável";
                            var corTendenciaGeral = margemFinal > margemInicial ? "success" : margemFinal < margemInicial ? "danger" : "warning";
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="alert alert-@corTendenciaGeral">
                                    <h5><i class="fas fa-chart-line"></i> Análise de Tendência:</h5>
                                    <ul class="mb-0">
                                        <li><strong>Tendência geral:</strong> @tendenciaGeral (@margemInicial.ToString("N1")% → @margemFinal.ToString("N1")%)</li>
                                        <li><strong>Períodos lucrativos:</strong> @periodosLucrativos de @totalPeriodos (@((decimal)periodosLucrativos / totalPeriodos * 100).ToString("N1")%)</li>
                                        <li><strong>Melhor período:</strong> @Model.OrderByDescending(p => p.MargemCalculada).First().Periodo (@Model.Max(p => p.MargemCalculada).ToString("N1")%)</li>
                                        <li><strong>Pior período:</strong> @Model.OrderBy(p => p.MargemCalculada).First().Periodo (@Model.Min(p => p.MargemCalculada).ToString("N1")%)</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <h5><i class="fas fa-lightbulb"></i> Recomendações:</h5>
                                    <ul class="mb-0">
                                        @if (tendenciaGeral == "Melhorando")
                                        {
                                            <li>Manter estratégias que estão funcionando</li>
                                            <li>Identificar fatores de sucesso para replicar</li>
                                        }
                                        else if (tendenciaGeral == "Piorando")
                                        {
                                            <li>Revisar política de preços urgentemente</li>
                                            <li>Analisar aumento de custos dos fornecedores</li>
                                            <li>Verificar descontos excessivos</li>
                                        }
                                        else
                                        {
                                            <li>Buscar oportunidades de melhoria</li>
                                            <li>Implementar estratégias para aumentar margem</li>
                                        }
                                        <li>Monitorar tendência mensalmente</li>
                                        <li>Definir metas de margem por período</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhuma venda com margem calculada encontrada no período selecionado.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar aos Relatórios
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-danger { background-color: rgba(220, 53, 69, 0.1) !important; }
</style>