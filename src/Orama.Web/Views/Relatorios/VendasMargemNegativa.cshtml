@model IEnumerable<Orama.Application.Services.VendaMargemNegativa>
@{
    ViewData["Title"] = "Vendas com Margem Negativa";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="dataInicio" class="form-label">Data Início:</label>
                            <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
                        </div>
                        <div class="col-md-4">
                            <label for="dataFim" class="form-label">Data Fim:</label>
                            <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </form>

                    @if (Model.Any())
                    {
                        <!-- Alerta de Problema -->
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle"></i> Atenção: Vendas com Prejuízo Detectadas!</h5>
                            <p class="mb-0">
                                Foram encontradas <strong>@ViewBag.QuantidadeVendas vendas</strong> com margem negativa, 
                                totalizando um prejuízo de <strong>@(((decimal)ViewBag.TotalPrejuizo).ToString("C"))</strong>.
                            </p>
                        </div>

                        <!-- Resumo -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-danger text-white">
                                    <div class="card-body text-center">
                                        <h5>Vendas com Prejuízo</h5>
                                        <h3>@ViewBag.QuantidadeVendas</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white">
                                    <div class="card-body text-center">
                                        <h5>Prejuízo Total</h5>
                                        <h3>@(((decimal)ViewBag.TotalPrejuizo).ToString("C"))</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white">
                                    <div class="card-body text-center">
                                        <h5>Maior Prejuízo</h5>
                                        <h3>@Model.Min(v => v.LucroNegativo).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-secondary text-white">
                                    <div class="card-body text-center">
                                        <h5>Valor Vendido</h5>
                                        <h3>@Model.Sum(v => v.ValorVenda).ToString("C")</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabela de Vendas -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Venda</th>
                                        <th>Cliente</th>
                                        <th>Data</th>
                                        <th>Valor Venda</th>
                                        <th>Custo Total</th>
                                        <th>Prejuízo</th>
                                        <th>Margem %</th>
                                        <th>% Prejuízo</th>
                                        <th>Produtos Principais</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var venda in Model)
                                    {
                                        <tr class="table-danger">
                                            <td><strong>@venda.NumeroVenda</strong></td>
                                            <td>@venda.NomeCliente</td>
                                            <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                                            <td>@venda.ValorVenda.ToString("C")</td>
                                            <td>@venda.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="text-danger">
                                                    @venda.LucroNegativo.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="text-danger">
                                                    @venda.MargemPercentual.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>
                                                <span class="badge @(venda.PercentualPrejuizo > 20 ? "bg-danger" : venda.PercentualPrejuizo > 10 ? "bg-warning" : "bg-info")">
                                                    @venda.PercentualPrejuizo.ToString("N1")%
                                                </span>
                                            </td>
                                            <td>
                                                <small>@venda.ProdutosPrincipaisTexto</small>
                                            </td>
                                            <td>
                                                <a asp-controller="Vendas" asp-action="Detalhes" asp-route-id="@venda.VendaId" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="3">TOTAIS:</th>
                                        <th><strong>@Model.Sum(v => v.ValorVenda).ToString("C")</strong></th>
                                        <th><strong>@Model.Sum(v => v.CustoTotal).ToString("C")</strong></th>
                                        <th><strong class="text-danger">@Model.Sum(v => v.LucroNegativo).ToString("C")</strong></th>
                                        <th><strong>@(Model.Sum(v => v.ValorVenda) > 0 ? ((Model.Sum(v => v.LucroNegativo) / Model.Sum(v => v.ValorVenda)) * 100).ToString("N1") : "0,0")%</strong></th>
                                        <th colspan="3">-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Análise e Recomendações -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="alert alert-warning">
                                    <h5><i class="fas fa-chart-pie"></i> Análise por Impacto:</h5>
                                    <ul class="mb-0">
                                        <li><strong>Alto impacto (&gt;20%):</strong> @Model.Count(v => v.PercentualPrejuizo > 20) vendas</li>
                                        <li><strong>Médio impacto (10-20%):</strong> @Model.Count(v => v.PercentualPrejuizo > 10 && v.PercentualPrejuizo <= 20) vendas</li>
                                        <li><strong>Baixo impacto (&lt;10%):</strong> @Model.Count(v => v.PercentualPrejuizo <= 10) vendas</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <h5><i class="fas fa-lightbulb"></i> Recomendações:</h5>
                                    <ul class="mb-0">
                                        <li>Revisar política de preços dos produtos problemáticos</li>
                                        <li>Verificar se os custos estão atualizados</li>
                                        <li>Analisar descontos excessivos aplicados</li>
                                        <li>Considerar renegociação com fornecedores</li>
                                        <li>Treinar equipe sobre margem mínima</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <h5><i class="fas fa-check-circle"></i> Excelente!</h5>
                            <p class="mb-0">
                                Nenhuma venda com margem negativa encontrada no período selecionado. 
                                Todas as vendas estão sendo realizadas com margem positiva.
                            </p>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar aos Relatórios
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-danger { background-color: rgba(220, 53, 69, 0.1) !important; }
</style>