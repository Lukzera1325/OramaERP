@model IEnumerable<Orama.Application.Services.ProdutoLucratividade>
@{
    ViewData["Title"] = "Produtos Mais Lucrativos";
    var resumo = ViewBag.Resumo;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="dataInicio" class="form-label">Data Início:</label>
                            <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
                        </div>
                        <div class="col-md-3">
                            <label for="dataFim" class="form-label">Data Fim:</label>
                            <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
                        </div>
                        <div class="col-md-3">
                            <label for="limite" class="form-label">Quantidade:</label>
                            <select name="limite" class="form-control">
                                <option value="10" @(ViewBag.Limite == 10 ? "selected" : "")>Top 10</option>
                                <option value="20" @(ViewBag.Limite == 20 ? "selected" : "")>Top 20</option>
                                <option value="50" @(ViewBag.Limite == 50 ? "selected" : "")>Top 50</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </form>

                    <!-- Resumo do Período -->
                    <div class="row mb-4">
                        <div class="col-md-2">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>Total Vendas</h5>
                                    <h3>@resumo.TotalVendas</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h5>Receita Total</h5>
                                    <h3>@(((decimal)resumo.ReceitaTotal).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-secondary text-white">
                                <div class="card-body text-center">
                                    <h5>Custo Total</h5>
                                    <h3>@(((decimal)resumo.CustoTotal).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.LucroTotal >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Lucro Total</h5>
                                    <h3>@(((decimal)resumo.LucroTotal).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(resumo.MargemMedia >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>Margem Média</h5>
                                    <h3>@(((decimal)resumo.MargemMedia).ToString("N1"))%</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h5>Produtos</h5>
                                    <h3>@Model.Count()</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela de Produtos -->
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ranking</th>
                                        <th>Código</th>
                                        <th>Produto</th>
                                        <th>Qtd. Vendida</th>
                                        <th>Receita Total</th>
                                        <th>Custo Total</th>
                                        <th>Lucro Total</th>
                                        <th>Margem %</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int ranking = 1;}
                                    @foreach (var produto in Model)
                                    {
                                        <tr class="@(ranking <= 3 ? "table-success" : ranking <= 10 ? "table-info" : "")">
                                            <td>
                                                @if (ranking <= 3)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="fas fa-trophy"></i> @ranking°
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@ranking°</span>
                                                }
                                            </td>
                                            <td><strong>@produto.CodigoProduto</strong></td>
                                            <td>@produto.NomeProduto</td>
                                            <td>@produto.QuantidadeVendida.ToString("N2")</td>
                                            <td>@produto.ReceitaTotal.ToString("C")</td>
                                            <td>@produto.CustoTotal.ToString("C")</td>
                                            <td>
                                                <strong class="@(produto.LucroTotal >= 0 ? "text-success" : "text-danger")">
                                                    @produto.LucroTotal.ToString("C")
                                                </strong>
                                            </td>
                                            <td>
                                                <strong class="@(produto.MargemMedia >= 0 ? "text-success" : "text-danger")">
                                                    @produto.MargemMedia.ToString("N1")%
                                                </strong>
                                            </td>
                                            <td>
                                                @if (produto.EhLucrativo)
                                                {
                                                    if (produto.MargemMedia > 30)
                                                    {
                                                        <span class="badge bg-success">Excelente</span>
                                                    }
                                                    else if (produto.MargemMedia > 15)
                                                    {
                                                        <span class="badge bg-primary">Bom</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Regular</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Prejuízo</span>
                                                }
                                            </td>
                                        </tr>
                                        ranking++;
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="3">TOTAIS:</th>
                                        <th>@Model.Sum(p => p.QuantidadeVendida).ToString("N2")</th>
                                        <th><strong>@Model.Sum(p => p.ReceitaTotal).ToString("C")</strong></th>
                                        <th><strong>@Model.Sum(p => p.CustoTotal).ToString("C")</strong></th>
                                        <th><strong class="@(Model.Sum(p => p.LucroTotal) >= 0 ? "text-success" : "text-danger")">@Model.Sum(p => p.LucroTotal).ToString("C")</strong></th>
                                        <th><strong>@(Model.Sum(p => p.ReceitaTotal) > 0 ? ((Model.Sum(p => p.LucroTotal) / Model.Sum(p => p.ReceitaTotal)) * 100).ToString("N1") : "0,0")%</strong></th>
                                        <th>-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Insights -->
                        <div class="alert alert-success">
                            <h5><i class="fas fa-lightbulb"></i> Insights:</h5>
                            <ul class="mb-0">
                                <li><strong>Produto mais lucrativo:</strong> @Model.First().NomeProduto com @Model.First().LucroTotal.ToString("C") de lucro</li>
                                <li><strong>Melhor margem:</strong> @Model.OrderByDescending(p => p.MargemMedia).First().NomeProduto com @Model.Max(p => p.MargemMedia).ToString("N1")% de margem</li>
                                <li><strong>Produtos lucrativos:</strong> @Model.Count(p => p.EhLucrativo) de @Model.Count() produtos (@((decimal)Model.Count(p => p.EhLucrativo) / Model.Count() * 100).ToString("N1")%)</li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhum produto com vendas encontrado no período selecionado.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar aos Relatórios
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
    
    .table-success { background-color: rgba(25, 135, 84, 0.1) !important; }
    .table-info { background-color: rgba(13, 202, 240, 0.1) !important; }
</style>