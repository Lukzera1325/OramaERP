@model IEnumerable<UsuarioViewModel>
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users-cog me-2"></i>Usuários</h2>
    @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Usuarios.Incluir"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Novo Usuário
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Perfil</th>
                            <th>Telefone</th>
                            <th>Último Login</th>
                            <th>Status</th>
                            <th width="150">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            @usuario.Nome.Substring(0, 1).ToUpper()
                                        </div>
                                        <strong>@usuario.Nome</strong>
                                    </div>
                                </td>
                                <td>@usuario.Email</td>
                                <td>
                                    <span class="badge bg-info">@usuario.NomePerfil</span>
                                </td>
                                <td>@(usuario.Telefone ?? "-")</td>
                                <td>
                                    @if (usuario.UltimoLogin.HasValue)
                                    {
                                        <small class="text-muted">
                                            @usuario.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Nunca logou</small>
                                    }
                                </td>
                                <td>
                                    @if (usuario.Ativo)
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inativo</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Usuarios.Visualizar"))
                                        {
                                            <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-outline-info" title="Detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Usuarios.Alterar"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-outline-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Usuarios.Excluir"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-outline-danger" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Nenhum usuário encontrado</h5>
                <p class="text-muted">Clique em "Novo Usuário" para adicionar o primeiro usuário.</p>
            </div>
        }
    </div>
</div>

<style>
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--santorini-blue) 0%, var(--santorini-light-blue) 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
    }
</style>