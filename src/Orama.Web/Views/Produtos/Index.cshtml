@model IEnumerable<Orama.Domain.Entities.Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="container-fluid">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-boxes text-primary me-2"></i>Produtos
            </h2>
            <p class="text-muted mb-0">Gerencie o catálogo de produtos</p>
        </div>
        <div>
            <a asp-action="EstoqueBaixo" class="btn btn-warning me-2">
                <i class="fas fa-exclamation-triangle me-1"></i>Estoque Baixo
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Novo Produto
            </a>
            </a>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" name="busca" class="form-control" 
                               placeholder="Buscar por código ou descrição..." 
                               value="@ViewBag.Busca">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i>Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabela de Produtos -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Código</th>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th class="text-center">Unidade</th>
                            <th class="text-end">Preço Custo</th>
                            <th class="text-end">Preço Venda</th>
                            <th class="text-center">Estoque</th>
                            <th class="text-center" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="fas fa-box-open fa-3x text-muted mb-3 d-block"></i>
                                    <p class="text-muted mb-0">Nenhum produto encontrado</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var produto in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@produto.Codigo</span>
                                    </td>
                                    <td>
                                        <strong>@produto.Descricao</strong>
                                        @if (!string.IsNullOrEmpty(produto.Ncm))
                                        {
                                            <br><small class="text-muted">NCM: @produto.Ncm</small>
                                        }
                                    </td>
                                    <td>
                                        @if (produto.CategoriaNavigation != null)
                                        {
                                            <span class="badge bg-info">@produto.CategoriaNavigation.Nome</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">@produto.Unidade</td>
                                    <td class="text-end">R$ @produto.PrecoCusto.ToString("N2")</td>
                                    <td class="text-end">
                                        <strong>R$ @produto.PrecoVenda.ToString("N2")</strong>
                                    </td>
                                    <td class="text-center">
                                        @if (produto.ControlaEstoque)
                                        {
                                            if (produto.EstoqueBaixo)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                                    @produto.EstoqueAtual.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@produto.EstoqueAtual.ToString("N2")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/C</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@produto.Id" 
                                               class="btn btn-outline-info" title="Detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@produto.Id" 
                                               class="btn btn-outline-primary" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@produto.Id" 
                                               class="btn btn-outline-danger" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.Any())
        {
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Total: @Model.Count() produto(s)
                </small>
            </div>
        }
    </div>
</div>
