@model Orama.Web.Models.ProdutoViewModel
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container-fluid">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-edit text-primary me-2"></i>Editar Produto
            </h2>
            <p class="text-muted mb-0">
                <span class="badge bg-secondary">@Model.Codigo</span> @Model.Descricao
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Voltar
        </a>
    </div>

    <form asp-action="Edit" method="post" id="formProduto">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <!-- Coluna Principal -->
            <div class="col-lg-8">
                <!-- Dados Básicos -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-info-circle me-2"></i>Dados Básicos
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Codigo" class="form-label"></label>
                                <input asp-for="Codigo" class="form-control text-uppercase" 
                                       placeholder="Ex: PROD001" maxlength="50" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                                <div id="codigoFeedback" class="invalid-feedback"></div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Descricao" class="form-label"></label>
                                <input asp-for="Descricao" class="form-control" 
                                       placeholder="Descrição do produto" maxlength="200" />
                                <span asp-validation-for="Descricao" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Unidade" class="form-label"></label>
                                <select asp-for="Unidade" class="form-select"
                                        asp-items="@Orama.Web.Models.ProdutoViewModel.UnidadesComuns">
                                </select>
                                <span asp-validation-for="Unidade" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="DescricaoDetalhada" class="form-label"></label>
                                <textarea asp-for="DescricaoDetalhada" class="form-control" rows="3"
                                          placeholder="Descrição detalhada do produto (opcional)"></textarea>
                                <span asp-validation-for="DescricaoDetalhada" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoriaId" class="form-label"></label>
                                <select asp-for="CategoriaId" class="form-select" asp-items="Model.Categorias">
                                    <option value="">-- Selecione --</option>
                                </select>
                                <span asp-validation-for="CategoriaId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Preços -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="fas fa-dollar-sign me-2"></i>Preços
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="PrecoCusto" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="PrecoCusto" type="number" step="0.01" min="0"
                                           class="form-control" id="precoCusto" />
                                </div>
                                <span asp-validation-for="PrecoCusto" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MargemLucro" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MargemLucro" type="number" step="0.01" min="0" max="100"
                                           class="form-control" id="margemLucro" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="MargemLucro" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PrecoVenda" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input asp-for="PrecoVenda" type="number" step="0.01" min="0"
                                           class="form-control" id="precoVenda" />
                                </div>
                                <span asp-validation-for="PrecoVenda" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Estoque -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-warning text-dark">
                        <i class="fas fa-warehouse me-2"></i>Controle de Estoque
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="ControlaEstoque" class="form-check-input" 
                                           id="controlaEstoque" />
                                    <label class="form-check-label" for="controlaEstoque">
                                        Controlar estoque deste produto
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4 campo-estoque">
                                <label asp-for="EstoqueAtual" class="form-label"></label>
                                <input asp-for="EstoqueAtual" type="number" step="0.01" min="0"
                                       class="form-control" />
                                <span asp-validation-for="EstoqueAtual" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 campo-estoque">
                                <label asp-for="EstoqueMinimo" class="form-label"></label>
                                <input asp-for="EstoqueMinimo" type="number" step="0.01" min="0"
                                       class="form-control" />
                                <span asp-validation-for="EstoqueMinimo" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 campo-estoque">
                                <label asp-for="EstoqueMaximo" class="form-label"></label>
                                <input asp-for="EstoqueMaximo" type="number" step="0.01" min="0"
                                       class="form-control" />
                                <span asp-validation-for="EstoqueMaximo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Coluna Lateral -->
            <div class="col-lg-4">
                <!-- Classificação Fiscal -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <i class="fas fa-file-invoice me-2"></i>Classificação Fiscal
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Ncm" class="form-label"></label>
                            <input asp-for="Ncm" class="form-control" placeholder="00000000"
                                   maxlength="10" />
                            <span asp-validation-for="Ncm" class="text-danger"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Cest" class="form-label"></label>
                            <input asp-for="Cest" class="form-control" placeholder="0000000"
                                   maxlength="10" />
                            <span asp-validation-for="Cest" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Dimensões -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white">
                        <i class="fas fa-ruler-combined me-2"></i>Dimensões
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <label asp-for="Peso" class="form-label"></label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Peso" type="number" step="0.001" min="0"
                                           class="form-control" />
                                    <span class="input-group-text">kg</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label asp-for="Altura" class="form-label"></label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Altura" type="number" step="0.01" min="0"
                                           class="form-control" />
                                    <span class="input-group-text">cm</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label asp-for="Largura" class="form-label"></label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Largura" type="number" step="0.01" min="0"
                                           class="form-control" />
                                    <span class="input-group-text">cm</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label asp-for="Profundidade" class="form-label"></label>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Profundidade" type="number" step="0.01" min="0"
                                           class="form-control" />
                                    <span class="input-group-text">cm</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Observações -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white">
                        <i class="fas fa-sticky-note me-2"></i>Observações
                    </div>
                    <div class="card-body">
                        <textarea asp-for="Observacoes" class="form-control" rows="4"
                                  placeholder="Observações internas..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botões -->
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Salvar Alterações
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var produtoId = @Model.Id;
            
            // Toggle campos de estoque
            function toggleCamposEstoque() {
                var controla = $('#controlaEstoque').is(':checked');
                $('.campo-estoque').toggle(controla);
            }
            
            $('#controlaEstoque').change(toggleCamposEstoque);
            toggleCamposEstoque();

            // Calcular preço de venda baseado na margem
            function calcularPrecoVenda() {
                var custo = parseFloat($('#precoCusto').val()) || 0;
                var margem = parseFloat($('#margemLucro').val()) || 0;
                
                if (custo > 0 && margem >= 0) {
                    var venda = custo * (1 + (margem / 100));
                    $('#precoVenda').val(venda.toFixed(2));
                }
            }

            // Calcular margem baseada no preço de venda
            function calcularMargem() {
                var custo = parseFloat($('#precoCusto').val()) || 0;
                var venda = parseFloat($('#precoVenda').val()) || 0;
                
                if (custo > 0 && venda > 0) {
                    var margem = ((venda - custo) / custo) * 100;
                    $('#margemLucro').val(margem.toFixed(2));
                }
            }

            $('#precoCusto, #margemLucro').on('change', calcularPrecoVenda);
            $('#precoVenda').on('change', calcularMargem);

            // Verificar código duplicado
            $('#Codigo').on('blur', function() {
                var codigo = $(this).val();
                if (codigo) {
                    $.get('@Url.Action("VerificarCodigo")', { codigo: codigo, id: produtoId }, function(data) {
                        if (data.existe) {
                            $('#Codigo').addClass('is-invalid');
                            $('#codigoFeedback').text('Este código já está em uso').show();
                        } else {
                            $('#Codigo').removeClass('is-invalid');
                            $('#codigoFeedback').hide();
                        }
                    });
                }
            });

            // Converter código para maiúsculo
            $('#Codigo').on('input', function() {
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>
}
