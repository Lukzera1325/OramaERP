@model Orama.Domain.Entities.Produto
@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container-fluid">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-trash text-danger me-2"></i>Excluir Produto
            </h2>
            <p class="text-muted mb-0">Confirme a exclusão do produto</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Voltar
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Alerta de Confirmação -->
            <div class="alert alert-danger mb-4">
                <h5 class="alert-heading">
                    <i class="fas fa-exclamation-triangle me-2"></i>Atenção!
                </h5>
                <p class="mb-0">
                    Você está prestes a excluir o produto abaixo. Esta ação não pode ser desfeita.
                </p>
            </div>

            <!-- Dados do Produto -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <i class="fas fa-box me-2"></i>Dados do Produto
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Código</label>
                            <p class="fw-bold">
                                <span class="badge bg-secondary fs-6">@Model.Codigo</span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Descrição</label>
                            <p class="fw-bold">@Model.Descricao</p>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Unidade</label>
                            <p class="fw-bold">@Model.Unidade</p>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Preço de Custo</label>
                            <p class="fw-bold">R$ @Model.PrecoCusto.ToString("N2")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Preço de Venda</label>
                            <p class="fw-bold text-success">R$ @Model.PrecoVenda.ToString("N2")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Estoque Atual</label>
                            <p class="fw-bold">
                                @if (Model.ControlaEstoque)
                                {
                                    @Model.EstoqueAtual.ToString("N2")
                                }
                                else
                                {
                                    <span class="text-muted">N/C</span>
                                }
                            </p>
                        </div>
                    </div>
                    @if (Model.Categoria != null)
                    {
                        <hr>
                        <div class="row">
                            <div class="col-12">
                                <label class="form-label text-muted small">Categoria</label>
                                <p class="mb-0">
                                    <span class="badge bg-info">@Model.CategoriaNavigation.Nome</span>
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Formulário de Confirmação -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <p class="text-muted mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                O produto será marcado como inativo e não aparecerá mais nas listagens.
                            </p>
                            <div>
                                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                                    <i class="fas fa-times me-1"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-1"></i>Confirmar Exclusão
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
