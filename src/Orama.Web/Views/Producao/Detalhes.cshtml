@model Orama.Domain.Entities.OrdemProducao
@{
    ViewData["Title"] = $"Ordem de Produção {Model.Numero}";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th>Número:</th>
                                    <td>@Model.Numero</td>
                                </tr>
                                <tr>
                                    <th>Produto:</th>
                                    <td>@Model.Produto.Descricao</td>
                                </tr>
                                <tr>
                                    <th>Quantidade Planejada:</th>
                                    <td>@Model.QuantidadePlanejada.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th>Quantidade Produzida:</th>
                                    <td>@Model.QuantidadeProduzida.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td>
                                        <span class="badge bg-primary">@Model.StatusDescricao</span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <th>Data Criação:</th>
                                    <td>@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                                <tr>
                                    <th>Data Planejada:</th>
                                    <td>@Model.DataPlanejada.ToString("dd/MM/yyyy")</td>
                                </tr>
                                @if (Model.DataInicio.HasValue)
                                {
                                    <tr>
                                        <th>Data Início:</th>
                                        <td>@Model.DataInicio.Value.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                                @if (Model.DataFim.HasValue)
                                {
                                    <tr>
                                        <th>Data Fim:</th>
                                        <td>@Model.DataFim.Value.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                                <tr>
                                    <th>Custo Material:</th>
                                    <td>@Model.CustoMaterial.ToString("C")</td>
                                </tr>
                                @if (Model.CustoCalculado)
                                {
                                    <tr>
                                        <th>Custo Total Produção:</th>
                                        <td><strong>@Model.CustoTotalProducao.ToString("C")</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Custo Unitário:</th>
                                        <td><strong>@Model.CustoUnitarioProducao.ToString("C")</strong></td>
                                    </tr>
                                    <tr>
                                        <th>Data Cálculo Custo:</th>
                                        <td>@Model.DataCustoCalculado?.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Observacoes))
                    {
                        <div class="row">
                            <div class="col-12">
                                <h5>Observações:</h5>
                                <p>@Model.Observacoes</p>
                            </div>
                        </div>
                    }

                    @if (Model.Itens.Any())
                    {
                        <div class="row">
                            <div class="col-12">
                                <h5>Componentes:</h5>
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Produto</th>
                                            <th>Qtd. Planejada</th>
                                            <th>Qtd. Consumida</th>
                                            <th>Custo Unit.</th>
                                            <th>Custo Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Itens)
                                        {
                                            <tr>
                                                <td>@item.Produto.Descricao</td>
                                                <td>@item.QuantidadePlanejada.ToString("N2")</td>
                                                <td>@item.QuantidadeConsumida.ToString("N2")</td>
                                                <td>@item.CustoUnitario.ToString("C")</td>
                                                <td>@item.CustoTotal.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    @* Botões de ação baseados no status atual da ordem *@
                    @if (Model.PodeLiberarParaProducao())
                    {
                        <form asp-action="LiberarParaProducao" asp-route-id="@Model.Id" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-success" title="Liberar ordem para iniciar produção">
                                <i class="fas fa-check"></i> Liberar para Produção
                            </button>
                        </form>
                    }
                    @if (Model.PodeIniciarProducao())
                    {
                        <form asp-action="IniciarProducao" asp-route-id="@Model.Id" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-warning" title="Iniciar execução da produção">
                                <i class="fas fa-play"></i> Iniciar Produção
                            </button>
                        </form>
                    }
                    @if (Model.PodeFinalizarProducao())
                    {
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#finalizarModal" title="Finalizar produção e atualizar estoque">
                            <i class="fas fa-stop"></i> Finalizar Produção
                        </button>
                    }
                    @if (Model.PodeCancelarOrdem())
                    {
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelarModal" title="Cancelar ordem de produção">
                            <i class="fas fa-times"></i> Cancelar Ordem
                        </button>
                    }
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar à Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Finalizar Produção -->
<div class="modal fade" id="finalizarModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="FinalizarProducao" asp-route-id="@Model.Id" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Finalizar Produção</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        <i class="fas fa-info-circle"></i> 
                        Ao finalizar, o sistema irá automaticamente:
                    </p>
                    <ul class="text-muted small">
                        <li>Dar baixa nos componentes utilizados</li>
                        <li>Dar entrada do produto acabado no estoque</li>
                        <li>Atualizar o status da ordem para "Finalizada"</li>
                    </ul>
                    <div class="form-group">
                        <label for="quantidadeProduzida">Quantidade Realmente Produzida:</label>
                        <input type="number" name="quantidadeProduzida" class="form-control" step="0.01" min="0.01" value="@Model.QuantidadePlanejada" required />
                        <small class="form-text text-muted">Informe a quantidade que foi efetivamente produzida</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> Finalizar Produção
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cancelar Ordem -->
<div class="modal fade" id="cancelarModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CancelarOrdemProducao" asp-route-id="@Model.Id" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Cancelar Ordem de Produção</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-warning">
                        <i class="fas fa-exclamation-triangle"></i> 
                        Tem certeza que deseja cancelar esta ordem de produção?
                    </p>
                    <div class="form-group">
                        <label for="motivo">Motivo do Cancelamento:</label>
                        <textarea name="motivo" class="form-control" rows="3" placeholder="Descreva o motivo do cancelamento..." required></textarea>
                        <small class="form-text text-muted">Este motivo será registrado no histórico da ordem</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times"></i> Cancelar Ordem
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>