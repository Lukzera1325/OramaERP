@model IEnumerable<Orama.Domain.Entities.OrdemProducao>
@{
    ViewData["Title"] = "Ordens de Produção";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div>
                        <a asp-action="RelatorioCustom" class="btn btn-success me-2">
                            <i class="fas fa-chart-line"></i> Relatório de Custos
                        </a>
                        <a asp-action="Criar" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Nova Ordem
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Número</th>
                                        <th>Produto</th>
                                        <th>Quantidade</th>
                                        <th>Status</th>
                                        <th>Data Criação</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ordem in Model)
                                    {
                                        <tr>
                                            <td>@ordem.Numero</td>
                                            <td>@ordem.Produto.Descricao</td>
                                            <td>@ordem.QuantidadePlanejada.ToString("N2")</td>
                                            <td>
                                                <span class="@ordem.StatusDescricao">
                                                    @ordem.StatusDescricao
                                                </span>
                                            </td>
                                            <td>@ordem.DataCriacao.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <a asp-action="Detalhes" asp-route-id="@ordem.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhuma ordem de produção encontrada.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>