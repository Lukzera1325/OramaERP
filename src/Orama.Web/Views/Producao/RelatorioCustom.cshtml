@model IEnumerable<Orama.Domain.Entities.OrdemProducao>
@{
    ViewData["Title"] = "Relatório de Custos de Produção";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <!-- Filtros -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label for="dataInicio" class="form-label">Data Início:</label>
                            <input type="date" name="dataInicio" class="form-control" value="@ViewBag.DataInicio" />
                        </div>
                        <div class="col-md-4">
                            <label for="dataFim" class="form-label">Data Fim:</label>
                            <input type="date" name="dataFim" class="form-control" value="@ViewBag.DataFim" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                        </div>
                    </form>

                    <!-- Resumo -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <h5>Total de Ordens</h5>
                                    <h3>@ViewBag.TotalOrdens</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h5>Custo Total</h5>
                                    <h3>@(((decimal)ViewBag.CustoTotalPeriodo).ToString("C"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <h5>Qtd. Produzida</h5>
                                    <h3>@(((decimal)ViewBag.QuantidadeTotalProduzida).ToString("N2"))</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <h5>Custo Médio</h5>
                                    <h3>@(ViewBag.QuantidadeTotalProduzida > 0 ? (((decimal)ViewBag.CustoTotalPeriodo) / ((decimal)ViewBag.QuantidadeTotalProduzida)).ToString("C") : "R$ 0,00")</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela de Ordens -->
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ordem</th>
                                        <th>Produto</th>
                                        <th>Qtd. Produzida</th>
                                        <th>Custo Total</th>
                                        <th>Custo Unitário</th>
                                        <th>Data Finalização</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ordem in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@ordem.Numero</strong>
                                            </td>
                                            <td>@ordem.Produto.Descricao</td>
                                            <td>@ordem.QuantidadeProduzida.ToString("N2")</td>
                                            <td>
                                                <strong class="text-success">@ordem.CustoTotalProducao.ToString("C")</strong>
                                            </td>
                                            <td>
                                                <strong class="text-primary">@ordem.CustoUnitarioProducao.ToString("C")</strong>
                                            </td>
                                            <td>@ordem.DataFim?.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <a asp-action="Detalhes" asp-route-id="@ordem.Id" class="btn btn-sm btn-outline-primary" title="Ver detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="2">TOTAIS:</th>
                                        <th>@Model.Sum(o => o.QuantidadeProduzida).ToString("N2")</th>
                                        <th><strong>@Model.Sum(o => o.CustoTotalProducao).ToString("C")</strong></th>
                                        <th>-</th>
                                        <th colspan="2">-</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Nenhuma ordem de produção finalizada encontrada no período selecionado.
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Voltar à Lista
                    </a>
                    @if (Model.Any())
                    {
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .card-header, .card-footer, .btn { display: none !important; }
        .container-fluid { margin: 0; padding: 0; }
    }
</style>