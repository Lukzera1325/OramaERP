@model OrdemProducaoViewModel

@{
    ViewData["Title"] = "Nova Ordem de Produção";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-plus-circle"></i>
                        Nova Ordem de Produção
                    </h3>
                    <div class="card-tools">
                        <a asp-action="OrdensProducao" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Voltar
                        </a>
                    </div>
                </div>

                <form asp-action="CriarOrdemProducao" method="post">
                    <div class="card-body">
                        <div class="row">
                            <!-- Informações Básicas -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Numero" class="form-label">Número da OP</label>
                                    <input asp-for="Numero" class="form-control" readonly />
                                    <span asp-validation-for="Numero" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="ProdutoId" class="form-label">Produto *</label>
                                    <select asp-for="ProdutoId" class="form-control select2" asp-items="ViewBag.Produtos">
                                        <option value="">Selecione o produto...</option>
                                    </select>
                                    <span asp-validation-for="ProdutoId" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Quantidade" class="form-label">Quantidade *</label>
                                    <input asp-for="Quantidade" class="form-control" type="number" step="0.01" min="0.01" />
                                    <span asp-validation-for="Quantidade" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Prioridade" class="form-label">Prioridade</label>
                                    <select asp-for="Prioridade" class="form-control">
                                        <option value="Baixa">Baixa</option>
                                        <option value="Normal" selected>Normal</option>
                                        <option value="Alta">Alta</option>
                                        <option value="Urgente">Urgente</option>
                                    </select>
                                    <span asp-validation-for="Prioridade" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Datas e Observações -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DataPrevista" class="form-label">Data Prevista *</label>
                                    <input asp-for="DataPrevista" class="form-control" type="date" />
                                    <span asp-validation-for="DataPrevista" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="DataLimite" class="form-label">Data Limite</label>
                                    <input asp-for="DataLimite" class="form-control" type="date" />
                                    <span asp-validation-for="DataLimite" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Observacoes" class="form-label">Observações</label>
                                    <textarea asp-for="Observacoes" class="form-control" rows="4" placeholder="Observações sobre a ordem de produção..."></textarea>
                                    <span asp-validation-for="Observacoes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de Materiais Preview -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h5><i class="fas fa-list"></i> Lista de Materiais</h5>
                                <div id="listaMateriais" class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Produto</th>
                                                <th>Qtd. Unitária</th>
                                                <th>Qtd. Total</th>
                                                <th>Estoque Atual</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="materiaisBody">
                                            <tr>
                                                <td colspan="5" class="text-center text-muted">
                                                    Selecione um produto para visualizar os materiais necessários
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Resumo de Custos -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6><i class="fas fa-calculator"></i> Resumo de Custos</h6>
                                        <div class="row">
                                            <div class="col-6">
                                                <small class="text-muted">Custo Material:</small><br>
                                                <strong id="custoMaterial">R$ 0,00</strong>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted">Custo Total:</small><br>
                                                <strong id="custoTotal">R$ 0,00</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Criar Ordem de Produção
                        </button>
                        <a asp-action="OrdensProducao" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function() {
            // Initialize Select2
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%'
            });

            // Auto-generate OP number
            if (!$('#Numero').val()) {
                $('#Numero').val('OP' + new Date().getFullYear() + Math.random().toString().substr(2, 4));
            }

            // Set default date
            if (!$('#DataPrevista').val()) {
                var tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                $('#DataPrevista').val(tomorrow.toISOString().split('T')[0]);
            }

            // Load materials when product changes
            $('#ProdutoId').change(function() {
                var produtoId = $(this).val();
                var quantidade = $('#Quantidade').val() || 1;
                
                if (produtoId) {
                    loadListaMateriais(produtoId, quantidade);
                } else {
                    clearListaMateriais();
                }
            });

            // Update quantities when quantity changes
            $('#Quantidade').on('input', function() {
                var produtoId = $('#ProdutoId').val();
                var quantidade = $(this).val() || 1;
                
                if (produtoId) {
                    loadListaMateriais(produtoId, quantidade);
                }
            });

            function loadListaMateriais(produtoId, quantidade) {
                $.ajax({
                    url: '@Url.Action("ObterListaMateriais", "Producao")',
                    type: 'GET',
                    data: { produtoId: produtoId, quantidade: quantidade },
                    success: function(data) {
                        var tbody = $('#materiaisBody');
                        tbody.empty();
                        
                        if (data.length > 0) {
                            var custoTotal = 0;
                            
                            $.each(data, function(index, item) {
                                var statusClass = item.estoqueDisponivel >= item.quantidadeTotal ? 'success' : 'danger';
                                var statusText = item.estoqueDisponivel >= item.quantidadeTotal ? 'Disponível' : 'Insuficiente';
                                
                                custoTotal += item.custoTotal;
                                
                                var row = '<tr>' +
                                    '<td>' + item.produtoNome + '</td>' +
                                    '<td>' + item.quantidadeUnitaria.toFixed(2) + '</td>' +
                                    '<td>' + item.quantidadeTotal.toFixed(2) + '</td>' +
                                    '<td>' + item.estoqueDisponivel.toFixed(2) + '</td>' +
                                    '<td><span class="badge badge-' + statusClass + '">' + statusText + '</span></td>' +
                                    '</tr>';
                                tbody.append(row);
                            });
                            
                            $('#custoMaterial').text('R$ ' + custoTotal.toFixed(2).replace('.', ','));
                            $('#custoTotal').text('R$ ' + custoTotal.toFixed(2).replace('.', ','));
                        } else {
                            tbody.append('<tr><td colspan="5" class="text-center text-muted">Nenhum material encontrado para este produto</td></tr>');
                            $('#custoMaterial').text('R$ 0,00');
                            $('#custoTotal').text('R$ 0,00');
                        }
                    },
                    error: function() {
                        $('#materiaisBody').html('<tr><td colspan="5" class="text-center text-danger">Erro ao carregar lista de materiais</td></tr>');
                    }
                });
            }

            function clearListaMateriais() {
                $('#materiaisBody').html('<tr><td colspan="5" class="text-center text-muted">Selecione um produto para visualizar os materiais necessários</td></tr>');
                $('#custoMaterial').text('R$ 0,00');
                $('#custoTotal').text('R$ 0,00');
            }
        });
    </script>
}