@model IEnumerable<ListaMateriaisViewModel>

@{
    ViewData["Title"] = "Listas de Materiais (BOM)";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-list-alt"></i>
                        Listas de Materiais (BOM)
                    </h3>
                    <div class="card-tools">
                        <a asp-action="CriarListaMateriais" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Nova Lista
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Dashboard
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Filtros -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Produto:</label>
                                <select id="filtroProduto" class="form-control select2">
                                    <option value="">Todos os produtos</option>
                                    @foreach (var produto in ViewBag.Produtos as SelectList)
                                    {
                                        <option value="@produto.Value">@produto.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status:</label>
                                <select id="filtroStatus" class="form-control">
                                    <option value="">Todos</option>
                                    <option value="true">Ativa</option>
                                    <option value="false">Inativa</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <button type="button" class="btn btn-info btn-block" onclick="aplicarFiltros()">
                                    <i class="fas fa-search"></i> Filtrar
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <button type="button" class="btn btn-secondary btn-block" onclick="limparFiltros()">
                                    <i class="fas fa-eraser"></i> Limpar
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Tabela -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="listaMateriaisTable">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th>Versão</th>
                                    <th>Qtd. Componentes</th>
                                    <th>Custo Total</th>
                                    <th>Status</th>
                                    <th>Criação</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lista in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@lista.ProdutoDescricao</strong><br>
                                            <small class="text-muted">Código do produto</small>
                                        </td>
                                        <td>
                                            <span class="badge badge-info">v@lista.Versao</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-secondary">@lista.Itens.Count</span>
                                        </td>
                                        <td>
                                            <strong class="text-success">R$ @lista.CustoTotal.ToString("N2")</strong>
                                        </td>
                                        <td>
                                            @if (lista.Ativo)
                                            {
                                                <span class="badge badge-success">Ativa</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Inativa</span>
                                            }
                                        </td>
                                        <td>
                                            @lista.DataCriacao.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="DetalhesListaMateriais" asp-route-id="@lista.Id" 
                                                   class="btn btn-info btn-sm" title="Visualizar">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="EditarListaMateriais" asp-route-id="@lista.Id" 
                                                   class="btn btn-primary btn-sm" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button type="button" class="btn btn-warning btn-sm" 
                                                        onclick="duplicarLista('@lista.Id')" title="Duplicar">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                                <button type="button" class="btn btn-success btn-sm" 
                                                        onclick="explosaoMateriais('@lista.Id')" title="Explosão">
                                                    <i class="fas fa-sitemap"></i>
                                                </button>
                                                @if (!lista.Ativo)
                                                {
                                                    <button type="button" class="btn btn-danger btn-sm" 
                                                            onclick="excluirLista('@lista.Id')" title="Excluir">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-list-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma lista de materiais encontrada</h5>
                            <p class="text-muted">Clique em "Nova Lista" para criar sua primeira lista de materiais.</p>
                            <a asp-action="CriarListaMateriais" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Criar Primeira Lista
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Cards de Resumo -->
            <div class="row mt-3">
                <div class="col-md-3">
                    <div class="info-box">
                        <span class="info-box-icon bg-info">
                            <i class="fas fa-list-alt"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">Total de Listas</span>
                            <span class="info-box-number">@Model.Count()</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="info-box">
                        <span class="info-box-icon bg-success">
                            <i class="fas fa-check-circle"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">Listas Ativas</span>
                            <span class="info-box-number">@Model.Count(l => l.Ativo)</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="info-box">
                        <span class="info-box-icon bg-warning">
                            <i class="fas fa-boxes"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">Produtos com BOM</span>
                            <span class="info-box-number">@Model.Select(l => l.ProdutoId).Distinct().Count()</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="info-box">
                        <span class="info-box-icon bg-danger">
                            <i class="fas fa-dollar-sign"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">Custo Médio</span>
                            <span class="info-box-number">R$ @(Model.Any() ? Model.Average(l => l.CustoTotal).ToString("N0") : "0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Explosão Rápida -->
<div class="modal fade" id="modalExplosao" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Explosão de Materiais</h4>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Quantidade a Produzir:</label>
                    <input type="number" id="quantidadeExplosao" class="form-control" value="1" min="0.01" step="0.01" />
                </div>
                <div id="resultadoExplosao">
                    <!-- Resultado carregado via AJAX -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="calcularExplosao()">
                    <i class="fas fa-calculator"></i> Calcular
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    Fechar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var listaIdExplosao = null;

        $(document).ready(function() {
            // Initialize DataTable
            $('#listaMateriaisTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Portuguese-Brasil.json"
                },
                "order": [[5, "desc"]], // Order by creation date
                "pageLength": 25,
                "responsive": true
            });

            // Initialize Select2
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%'
            });
        });

        function aplicarFiltros() {
            var table = $('#listaMateriaisTable').DataTable();
            
            // Filter by product
            var produto = $('#filtroProduto').val();
            table.column(0).search(produto);
            
            // Filter by status
            var status = $('#filtroStatus').val();
            if (status !== '') {
                var statusText = status === 'true' ? 'Ativa' : 'Inativa';
                table.column(4).search(statusText);
            } else {
                table.column(4).search('');
            }
            
            table.draw();
        }

        function limparFiltros() {
            $('#filtroProduto').val('').trigger('change');
            $('#filtroStatus').val('');
            
            var table = $('#listaMateriaisTable').DataTable();
            table.search('').columns().search('').draw();
        }

        function duplicarLista(listaId) {
            if (confirm('Confirma a duplicação desta lista de materiais?')) {
                $.ajax({
                    url: '@Url.Action("DuplicarListaMateriais", "Producao")',
                    type: 'POST',
                    data: { 
                        id: listaId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Erro: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('Erro ao duplicar lista');
                    }
                });
            }
        }

        function excluirLista(listaId) {
            if (confirm('Confirma a exclusão desta lista de materiais?\n\nEsta ação não pode ser desfeita.')) {
                $.ajax({
                    url: '@Url.Action("ExcluirListaMateriais", "Producao")',
                    type: 'POST',
                    data: { 
                        id: listaId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert('Erro: ' + result.message);
                        }
                    },
                    error: function() {
                        alert('Erro ao excluir lista');
                    }
                });
            }
        }

        function explosaoMateriais(listaId) {
            listaIdExplosao = listaId;
            $('#quantidadeExplosao').val(1);
            $('#resultadoExplosao').html('<p class="text-muted">Clique em "Calcular" para ver a explosão de materiais.</p>');
            $('#modalExplosao').modal('show');
        }

        function calcularExplosao() {
            var quantidade = $('#quantidadeExplosao').val();
            
            if (!quantidade || quantidade <= 0) {
                alert('Informe uma quantidade válida');
                return;
            }
            
            $('#resultadoExplosao').html('<div class="text-center"><i class="fas fa-spinner fa-spin"></i> Calculando...</div>');
            
            $.ajax({
                url: '@Url.Action("CalcularExplosaoMateriais", "Producao")',
                type: 'GET',
                data: { 
                    listaId: listaIdExplosao,
                    quantidade: quantidade
                },
                success: function(data) {
                    var html = '<div class="table-responsive">' +
                               '<table class="table table-sm table-striped">' +
                               '<thead><tr>' +
                               '<th>Material</th>' +
                               '<th>Qtd. Necessária</th>' +
                               '<th>Estoque Atual</th>' +
                               '<th>Status</th>' +
                               '<th>Custo Total</th>' +
                               '</tr></thead><tbody>';
                    
                    var custoTotal = 0;
                    
                    $.each(data, function(index, item) {
                        var statusClass = item.estoqueDisponivel >= item.quantidadeNecessaria ? 'success' : 'danger';
                        var statusText = item.estoqueDisponivel >= item.quantidadeNecessaria ? 'OK' : 'Insuficiente';
                        
                        custoTotal += item.custoTotal;
                        
                        html += '<tr>' +
                                '<td>' + item.materialNome + '</td>' +
                                '<td>' + item.quantidadeNecessaria.toFixed(2) + '</td>' +
                                '<td>' + item.estoqueDisponivel.toFixed(2) + '</td>' +
                                '<td><span class="badge badge-' + statusClass + '">' + statusText + '</span></td>' +
                                '<td>R$ ' + item.custoTotal.toFixed(2) + '</td>' +
                                '</tr>';
                    });
                    
                    html += '</tbody></table></div>';
                    html += '<div class="alert alert-info mt-3">' +
                            '<strong>Custo Total da Produção: R$ ' + custoTotal.toFixed(2) + '</strong>' +
                            '</div>';
                    
                    $('#resultadoExplosao').html(html);
                },
                error: function() {
                    $('#resultadoExplosao').html('<div class="alert alert-danger">Erro ao calcular explosão de materiais</div>');
                }
            });
        }
    </script>
}