@model VendaViewModel
@{
    ViewData["Title"] = "Faturar Venda";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-file-invoice-dollar text-success me-2"></i>Faturar Venda</h2>
        <p class="text-muted mb-0">Confirme o faturamento da venda #@Model.Numero</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Voltar
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Confirmar Faturamento</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <strong>Venda:</strong> #@Model.Numero<br>
                    <strong>Cliente:</strong> @Model.ClienteNome<br>
                    <strong>Valor Total:</strong> <span class="fw-bold">@Model.ValorTotal.ToString("C")</span>
                </div>

                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Ao faturar esta venda:
                    <ul class="mb-0 mt-2">
                        <li>O estoque dos produtos será baixado</li>
                        <li>Uma conta a receber será gerada automaticamente</li>
                        <li>A venda não poderá mais ser editada</li>
                    </ul>
                </div>

                <form asp-action="Faturar" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="form-label">Conta Bancária (opcional)</label>
                        <select name="contaBancariaId" class="form-select" asp-items="ViewBag.ContasBancarias">
                            <option value="">Selecione uma conta bancária</option>
                        </select>
                        <small class="text-muted">Vincule a conta a receber a uma conta bancária</small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-check me-2"></i>Confirmar Faturamento
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
