@model VendaViewModel
@{
    ViewData["Title"] = "Excluir Venda";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-trash text-danger me-2"></i>Excluir Venda</h2>
        <p class="text-muted mb-0">Confirme a exclusão</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Voltar
    </a>
</div>

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Atenção!</h5>
    </div>
    <div class="card-body">
        <p class="lead">Tem certeza que deseja excluir esta venda?</p>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <dl>
                    <dt>Número</dt>
                    <dd>#@Model.Numero</dd>
                    <dt>Cliente</dt>
                    <dd>@Model.ClienteNome</dd>
                    <dt>Data</dt>
                    <dd>@Model.DataVenda.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl>
                    <dt>Valor Total</dt>
                    <dd class="fw-bold fs-4">@Model.ValorTotal.ToString("C")</dd>
                    <dt>Status</dt>
                    <dd><span class="badge bg-@Model.StatusCor">@Model.StatusDescricao</span></dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Confirmar Exclusão
                </button>
            </div>
        </form>
    </div>
</div>
