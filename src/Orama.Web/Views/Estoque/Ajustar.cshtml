@model AjusteEstoqueViewModel
@{
    ViewData["Title"] = "Ajustar Estoque";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Ajustar Estoque
                    </h3>
                </div>

                <form asp-action="Ajustar" method="post">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ProdutoId" class="form-label"></label>
                                    @Html.DropDownListFor(m => m.ProdutoId, Model.Produtos, "Selecione um produto...", new { @class = "form-select", required = "required", onchange = "carregarDadosProduto()" })
                                    <span asp-validation-for="ProdutoId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Motivo" class="form-label"></label>
                                    <input asp-for="Motivo" class="form-control" placeholder="Ex: Inventário físico, Ajuste por avaria, etc." required>
                                    <span asp-validation-for="Motivo" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Observacoes" class="form-label"></label>
                                    <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Observações adicionais sobre o ajuste..."></textarea>
                                    <span asp-validation-for="Observacoes" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div id="dadosProduto" style="display: @(Model.ProdutoId > 0 ? "block" : "none")">
                                    <h5 class="border-bottom pb-2 mb-3">Informações do Produto</h5>
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Produto Selecionado</label>
                                        <input type="text" id="produtoNome" class="form-control" readonly>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <label asp-for="EstoqueAtual" class="form-label"></label>
                                            <input asp-for="EstoqueAtual" class="form-control" readonly>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="QuantidadeReal" class="form-label"></label>
                                            <input asp-for="QuantidadeReal" class="form-control" type="number" step="0.01" min="0" required onchange="calcularDiferenca()">
                                            <span asp-validation-for="QuantidadeReal" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        <div class="alert alert-info" id="alertaDiferenca">
                                            <h6 class="mb-2">
                                                <i class="fas fa-calculator me-1"></i>Diferença Calculada
                                            </h6>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <strong>Tipo de Ajuste:</strong><br>
                                                    <span id="tipoAjuste" class="badge bg-secondary">-</span>
                                                </div>
                                                <div class="col-md-6">
                                                    <strong>Diferença:</strong><br>
                                                    <span id="valorDiferenca" class="fs-5">0,00</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Posicao" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary" id="btnSalvar" disabled>
                                <i class="fas fa-save me-1"></i>Realizar Ajuste
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let produtoSelecionado = null;

        $(document).ready(function() {
            // Se já tem produto selecionado, carregar dados
            @if (Model.ProdutoId > 0)
            {
                <text>
                $('#produtoNome').val('@Model.ProdutoNome');
                calcularDiferenca();
                $('#btnSalvar').prop('disabled', false);
                </text>
            }
        });

        function carregarDadosProduto() {
            const produtoId = $('#ProdutoId').val();
            
            if (!produtoId || produtoId == '0') {
                $('#dadosProduto').hide();
                $('#btnSalvar').prop('disabled', true);
                return;
            }

            // Buscar dados do produto via AJAX
            $.get('/Estoque/ObterDadosProduto', { produtoId: produtoId })
                .done(function(response) {
                    if (response.success) {
                        produtoSelecionado = response.data;
                        
                        $('#produtoNome').val(response.data.nome);
                        $('#EstoqueAtual').val(response.data.estoqueAtual.toFixed(2));
                        $('#QuantidadeReal').val(response.data.estoqueAtual.toFixed(2));
                        
                        $('#dadosProduto').show();
                        calcularDiferenca();
                        $('#btnSalvar').prop('disabled', false);
                    } else {
                        alert('Erro ao carregar dados do produto: ' + response.message);
                    }
                })
                .fail(function() {
                    alert('Erro ao comunicar com o servidor');
                });
        }

        function calcularDiferenca() {
            const estoqueAtual = parseFloat($('#EstoqueAtual').val()) || 0;
            const quantidadeReal = parseFloat($('#QuantidadeReal').val()) || 0;
            const diferenca = quantidadeReal - estoqueAtual;

            // Atualizar tipo de ajuste
            let tipoAjuste = 'Sem Diferença';
            let badgeClass = 'bg-secondary';
            
            if (diferenca > 0) {
                tipoAjuste = 'Ajuste Positivo';
                badgeClass = 'bg-success';
            } else if (diferenca < 0) {
                tipoAjuste = 'Ajuste Negativo';
                badgeClass = 'bg-warning';
            }

            $('#tipoAjuste').removeClass().addClass('badge ' + badgeClass).text(tipoAjuste);
            
            // Atualizar valor da diferença
            const valorFormatado = Math.abs(diferenca).toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            
            let sinal = '';
            let corTexto = 'text-muted';
            
            if (diferenca > 0) {
                sinal = '+';
                corTexto = 'text-success';
            } else if (diferenca < 0) {
                sinal = '-';
                corTexto = 'text-warning';
            }
            
            $('#valorDiferenca').removeClass().addClass('fs-5 ' + corTexto).text(sinal + valorFormatado);
            
            // Habilitar/desabilitar botão baseado na diferença
            $('#btnSalvar').prop('disabled', diferenca === 0);
        }

        // Validação antes do submit
        $('form').on('submit', function(e) {
            const produtoId = $('#ProdutoId').val();
            const motivo = $('#Motivo').val().trim();
            
            if (!produtoId || produtoId == '0') {
                e.preventDefault();
                alert('Por favor, selecione um produto.');
                $('#ProdutoId').focus();
                return false;
            }
            
            if (!motivo) {
                e.preventDefault();
                alert('Por favor, informe o motivo do ajuste.');
                $('#Motivo').focus();
                return false;
            }
            
            const diferenca = parseFloat($('#QuantidadeReal').val()) - parseFloat($('#EstoqueAtual').val());
            if (diferenca === 0) {
                e.preventDefault();
                alert('Não há diferença entre o estoque atual e a quantidade real informada.');
                return false;
            }
            
            // Confirmação
            const tipoAjuste = diferenca > 0 ? 'positivo' : 'negativo';
            const valorDiferenca = Math.abs(diferenca).toFixed(2);
            
            if (!confirm(`Confirma o ajuste ${tipoAjuste} de ${valorDiferenca} unidades?\n\nMotivo: ${motivo}`)) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}