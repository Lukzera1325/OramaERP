@model List<MovimentacaoEstoqueViewModel>
@{
    ViewData["Title"] = "Movimentações de Estoque";
    var filtro = ViewBag.Filtro as MovimentacaoFiltroViewModel ?? new MovimentacaoFiltroViewModel();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exchange-alt me-2"></i>Movimentações de Estoque
                    </h3>
                    <div class="btn-group">
                        <a asp-action="Posicao" class="btn btn-info">
                            <i class="fas fa-boxes me-1"></i>Posição Estoque
                        </a>
                        <a asp-action="Ajustar" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i>Ajustar Estoque
                        </a>
                        <a asp-action="Inventario" class="btn btn-primary">
                            <i class="fas fa-clipboard-list me-1"></i>Inventário
                        </a>
                    </div>
                </div>

                <!-- Filtros -->
                <div class="card-body border-bottom">
                    <form method="get" asp-action="Index" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Produto</label>
                            @Html.DropDownListFor(m => filtro.ProdutoId, filtro.Produtos, new { @class = "form-select" })
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tipo</label>
                            @Html.DropDownListFor(m => filtro.Tipo, filtro.Tipos, new { @class = "form-select" })
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Data Inicial</label>
                            @Html.TextBoxFor(m => filtro.DataInicial, new { @class = "form-control", type = "date" })
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Data Final</label>
                            @Html.TextBoxFor(m => filtro.DataFinal, new { @class = "form-control", type = "date" })
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary me-2">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Limpar
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Data/Hora</th>
                                        <th>Produto</th>
                                        <th>Tipo</th>
                                        <th>Quantidade</th>
                                        <th>Estoque Ant.</th>
                                        <th>Estoque Post.</th>
                                        <th>Motivo</th>
                                        <th>Usuário</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in Model)
                                    {
                                        <tr>
                                            <td>
                                                <small>@mov.DataMovimentacao.ToString("dd/MM/yyyy")</small><br>
                                                <small class="text-muted">@mov.DataMovimentacao.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong>@mov.ProdutoCodigo</strong><br>
                                                <small class="text-muted">@mov.ProdutoNome</small>
                                            </td>
                                            <td>
                                                <span class="badge @mov.TipoBadgeClass">
                                                    @mov.TipoDescricao
                                                </span>
                                            </td>
                                            <td>
                                                <span class="@(mov.IsEntrada ? "text-success" : "text-danger")">
                                                    @(mov.IsEntrada ? "+" : "-")@mov.Quantidade.ToString("N2")
                                                </span>
                                            </td>
                                            <td>@mov.EstoqueAnterior.ToString("N2")</td>
                                            <td>
                                                <strong>@mov.EstoquePosterior.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(mov.Motivo))
                                                {
                                                    <span title="@mov.Motivo">
                                                        @(mov.Motivo.Length > 30 ? mov.Motivo.Substring(0, 30) + "..." : mov.Motivo)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(mov.UsuarioNome))
                                                {
                                                    <small>@mov.UsuarioNome</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Sistema</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma movimentação encontrada</h5>
                            <p class="text-muted">Ajuste os filtros ou realize movimentações de estoque</p>
                        </div>
                    }
                </div>

                @if (Model.Any())
                {
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">
                                    Exibindo @Model.Count movimentação(ões) (limitado a 100 registros)
                                </small>
                            </div>
                            <div class="col-md-6 text-end">
                                <small class="text-muted">
                                    Entradas: <span class="text-success">@Model.Where(m => m.IsEntrada).Sum(m => m.Quantidade).ToString("N2")</span> |
                                    Saídas: <span class="text-danger">@Model.Where(m => !m.IsEntrada).Sum(m => m.Quantidade).ToString("N2")</span>
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-submit do filtro quando mudar produto ou tipo
            $('#ProdutoId, #Tipo').change(function() {
                $(this).closest('form').submit();
            });
        });
    </script>
}