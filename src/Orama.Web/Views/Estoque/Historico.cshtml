@model List<MovimentacaoEstoqueViewModel>
@{
    ViewData["Title"] = "Histórico de Movimentações";
    var produto = ViewBag.Produto as Produto;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="card-title mb-0">
                            <i class="fas fa-history me-2"></i>Histórico de Movimentações
                        </h3>
                        @if (produto != null)
                        {
                            <p class="text-muted mb-0">
                                <strong>@produto.Codigo</strong> - @produto.Descricao
                            </p>
                        }
                    </div>
                    <div class="btn-group">
                        <a asp-action="Posicao" class="btn btn-info">
                            <i class="fas fa-boxes me-1"></i>Posição Estoque
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-list me-1"></i>Todas Movimentações
                        </a>
                    </div>
                </div>

                @if (produto != null)
                {
                    <div class="card-body border-bottom">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-boxes text-primary me-2"></i>
                                    <div>
                                        <small class="text-muted">Estoque Atual</small>
                                        <div class="fw-bold">@produto.EstoqueAtual.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-arrow-down text-warning me-2"></i>
                                    <div>
                                        <small class="text-muted">Estoque Mínimo</small>
                                        <div class="fw-bold">@produto.EstoqueMinimo.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-arrow-up text-success me-2"></i>
                                    <div>
                                        <small class="text-muted">Estoque Máximo</small>
                                        <div class="fw-bold">@produto.EstoqueMaximo.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-dollar-sign text-info me-2"></i>
                                    <div>
                                        <small class="text-muted">Preço Custo</small>
                                        <div class="fw-bold">@produto.PrecoCusto.ToString("C")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Data/Hora</th>
                                        <th>Tipo</th>
                                        <th>Quantidade</th>
                                        <th>Estoque Anterior</th>
                                        <th>Estoque Posterior</th>
                                        <th>Custo Unitário</th>
                                        <th>Motivo</th>
                                        <th>Usuário</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in Model)
                                    {
                                        <tr>
                                            <td>
                                                <small>@mov.DataMovimentacao.ToString("dd/MM/yyyy")</small><br>
                                                <small class="text-muted">@mov.DataMovimentacao.ToString("HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <span class="badge @mov.TipoBadgeClass">
                                                    @mov.TipoDescricao
                                                </span>
                                            </td>
                                            <td>
                                                <span class="@(mov.IsEntrada ? "text-success" : "text-danger") fw-bold">
                                                    @(mov.IsEntrada ? "+" : "-")@mov.Quantidade.ToString("N2")
                                                </span>
                                            </td>
                                            <td>@mov.EstoqueAnterior.ToString("N2")</td>
                                            <td>
                                                <strong>@mov.EstoquePosterior.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                @if (mov.CustoUnitario.HasValue)
                                                {
                                                    @mov.CustoUnitario.Value.ToString("C")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(mov.Motivo))
                                                {
                                                    <span title="@mov.Motivo">
                                                        @(mov.Motivo.Length > 40 ? mov.Motivo.Substring(0, 40) + "..." : mov.Motivo)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(mov.UsuarioNome))
                                                {
                                                    <small>@mov.UsuarioNome</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Sistema</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma movimentação encontrada</h5>
                            <p class="text-muted">Este produto ainda não possui movimentações de estoque</p>
                        </div>
                    }
                </div>

                @if (Model.Any())
                {
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">
                                    Total: @Model.Count movimentação(ões)
                                </small>
                            </div>
                            <div class="col-md-6 text-end">
                                <small class="text-muted">
                                    Entradas: <span class="text-success">@Model.Where(m => m.IsEntrada).Sum(m => m.Quantidade).ToString("N2")</span> |
                                    Saídas: <span class="text-danger">@Model.Where(m => !m.IsEntrada).Sum(m => m.Quantidade).ToString("N2")</span>
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>