@model IEnumerable<ClienteViewModel>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Clientes</h2>
    <div>
        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Clientes.Incluir"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Novo Cliente
            </a>
        }
    </div>
</div>

<!-- Filtros de busca -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="filtroNome" class="form-control" placeholder="Buscar por nome, CPF ou CNPJ...">
                </div>
            </div>
            <div class="col-md-3">
                <select id="filtroTipo" class="form-select">
                    <option value="">Todos os tipos</option>
                    <option value="1">Pessoa Física</option>
                    <option value="2">Pessoa Jurídica</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="button" id="btnLimparFiltros" class="btn btn-outline-secondary">
                    <i class="fas fa-eraser me-2"></i>Limpar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover" id="tabelaClientes">
                    <thead class="table-light">
                        <tr>
                            <th>Nome/Razão Social</th>
                            <th>CPF/CNPJ</th>
                            <th>Tipo</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Cidade/UF</th>
                            <th width="150">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in Model)
                        {
                            <tr data-tipo="@((int)cliente.TipoPessoa)" data-nome="@cliente.Nome.ToLower()" data-cpfcnpj="@cliente.CpfCnpj">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-2">
                                            @if (cliente.IsPessoaFisica)
                                            {
                                                <i class="fas fa-user"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-building"></i>
                                            }
                                        </div>
                                        <div>
                                            <strong>@cliente.Nome</strong>
                                            @if (!string.IsNullOrWhiteSpace(cliente.NomeFantasia))
                                            {
                                                <br><small class="text-muted">@cliente.NomeFantasia</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code>@cliente.CpfCnpj</code>
                                </td>
                                <td>
                                    @if (cliente.IsPessoaFisica)
                                    {
                                        <span class="badge bg-info">Pessoa Física</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Pessoa Jurídica</span>
                                    }
                                </td>
                                <td>@(cliente.Email ?? "-")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(cliente.Telefone))
                                    {
                                        @cliente.Telefone
                                    }
                                    else if (!string.IsNullOrWhiteSpace(cliente.Celular))
                                    {
                                        @cliente.Celular
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(cliente.Cidade) && !string.IsNullOrWhiteSpace(cliente.Uf))
                                    {
                                        @($"{cliente.Cidade}/{cliente.Uf}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Clientes.Visualizar"))
                                        {
                                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-outline-info" title="Detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        }
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Clientes.Alterar"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-outline-warning" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (ViewBag.UsuarioLogado != null && ((UsuarioLogadoViewModel)ViewBag.UsuarioLogado).Permissoes.Contains("Clientes.Excluir"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-outline-danger" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-users text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Nenhum cliente encontrado</h5>
                <p class="text-muted">Clique em "Novo Cliente" para adicionar o primeiro cliente.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Filtro por nome/CPF/CNPJ
            $('#filtroNome').on('keyup', function() {
                filtrarTabela();
            });

            // Filtro por tipo
            $('#filtroTipo').on('change', function() {
                filtrarTabela();
            });

            // Limpar filtros
            $('#btnLimparFiltros').on('click', function() {
                $('#filtroNome').val('');
                $('#filtroTipo').val('');
                filtrarTabela();
            });

            function filtrarTabela() {
                var filtroNome = $('#filtroNome').val().toLowerCase();
                var filtroTipo = $('#filtroTipo').val();

                $('#tabelaClientes tbody tr').each(function() {
                    var $row = $(this);
                    var nome = $row.data('nome');
                    var cpfCnpj = $row.data('cpfcnpj');
                    var tipo = $row.data('tipo').toString();

                    var mostrarNome = !filtroNome || nome.includes(filtroNome) || cpfCnpj.includes(filtroNome);
                    var mostrarTipo = !filtroTipo || tipo === filtroTipo;

                    if (mostrarNome && mostrarTipo) {
                        $row.show();
                    } else {
                        $row.hide();
                    }
                });
            }
        });
    </script>
}