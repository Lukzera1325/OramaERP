@model List<Orama.Domain.Entities.Fiscal.EmpresaFiscalConfig>
@{
    ViewData["Title"] = "Configurações Fiscais";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title">
                        <i class="fas fa-file-invoice-dollar"></i>
                        Configurações Fiscais
                    </h3>
                    <a href="@Url.Action("Criar")" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Nova Configuração
                    </a>
                </div>
                
                <div class="card-body">
                    @if (TempData["Sucesso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="fas fa-check-circle"></i>
                            @TempData["Sucesso"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fas fa-exclamation-triangle"></i>
                            @TempData["Erro"]
                            <button type="button" class="close" data-dismiss="alert">
                                <span>&times;</span>
                            </button>
                        </div>
                    }
                    
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Regime Tributário</th>
                                        <th>CRT</th>
                                        <th>UF</th>
                                        <th>Ambiente</th>
                                        <th>Versão Fiscal</th>
                                        <th>Vigência</th>
                                        <th>Status</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var config in Model)
                                    {
                                        var isVigente = config.EstaVigente(DateTime.Today);
                                        <tr class="@(isVigente ? "table-success" : "")">
                                            <td>
                                                <span class="badge badge-@(config.RegimeTributario == Orama.Domain.Entities.Fiscal.RegimeTributario.SimplesNacional ? "info" : "warning")">
                                                    @config.RegimeTributario
                                                </span>
                                            </td>
                                            <td>@config.CRT</td>
                                            <td>
                                                <strong>@config.UF</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-@(config.AmbienteFiscal == Orama.Domain.Entities.Fiscal.AmbienteFiscal.Producao ? "success" : "secondary")">
                                                    @config.AmbienteFiscal
                                                </span>
                                            </td>
                                            <td>
                                                <code>@config.VersaoFiscal</code>
                                            </td>
                                            <td>
                                                <small>
                                                    <strong>De:</strong> @config.VigenteDe.ToString("dd/MM/yyyy")<br>
                                                    <strong>Até:</strong> @(config.VigenteAte?.ToString("dd/MM/yyyy") ?? "Indefinido")
                                                </small>
                                            </td>
                                            <td>
                                                @if (isVigente)
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-check"></i>
                                                        Vigente
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">
                                                        <i class="fas fa-clock"></i>
                                                        Inativo
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("Editar", new { id = config.Id })" 
                                                       class="btn btn-outline-primary" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    
                                                    @if (isVigente)
                                                    {
                                                        <button type="button" class="btn btn-outline-warning" 
                                                                onclick="encerrarVigencia(@config.Id)" title="Encerrar Vigência">
                                                            <i class="fas fa-stop"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-file-invoice-dollar fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Nenhuma configuração fiscal encontrada</h5>
                            <p class="text-muted">Configure os parâmetros fiscais da empresa para começar.</p>
                            <a href="@Url.Action("Criar")" class="btn btn-primary">
                                <i class="fas fa-plus"></i>
                                Criar Primeira Configuração
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para encerrar vigência -->
<div class="modal fade" id="modalEncerrarVigencia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Encerrar Vigência</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <form id="formEncerrarVigencia" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Informe a data de encerramento da vigência:</p>
                    <input type="hidden" id="configId" name="id" />
                    <input type="date" id="dataEncerramento" name="dataEncerramento" 
                           class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-stop"></i>
                        Encerrar Vigência
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function encerrarVigencia(configId) {
    document.getElementById('configId').value = configId;
    document.getElementById('formEncerrarVigencia').action = '@Url.Action("EncerrarVigencia")';
    $('#modalEncerrarVigencia').modal('show');
}
</script>